<local:ThemedWindow x:Class="KronosScreenRemote.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="File Manager - Kronos" Width="960" Height="600" MinWidth="640" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <Window.Resources>
        <!-- Read-only path display fields; distinct from the app-wide editable TextBox style. -->
        <Style x:Key="PathTextStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background"      Value="{StaticResource WindowBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <DataTemplate x:Key="NameCell">
            <TextBlock Text="{Binding DisplayName}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"  Value="White"/>
                        <Setter Property="FontWeight"  Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter Property="Foreground" Value="#FFA8CFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <!-- Shared column defs so the GridSplitter aligns nav + list + toolbar rows -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Navigation bars ─────────────────────────────────── -->
        <Border Grid.Row="0" Grid.Column="0" Background="#FF252525" Padding="6 4">
            <DockPanel>
                <ComboBox x:Name="LocalDriveCombo" DockPanel.Dock="Left"
                          Width="135" Height="24" Margin="0 0 4 0"
                          DropDownOpened="OnLocalDriveDropDownOpened"
                          SelectionChanged="OnLocalDriveChanged"
                          ToolTip="Select drive"/>
                <Button x:Name="BtnLocalUp" DockPanel.Dock="Left" Content="↑" Width="28" Height="24"
                        Click="OnLocalUp" ToolTip="Parent directory - drag files here to move up"
                        Margin="0 0 6 0" AllowDrop="True"
                        DragOver="OnUpDragOver" DragLeave="OnUpDragLeave" Drop="OnUpDrop"/>
                <TextBlock DockPanel.Dock="Left" Text="Local: " Foreground="#FF88DD88"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="LocalPathBox" Style="{StaticResource PathTextStyle}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#FF444444"/>
        <Border Grid.Row="0" Grid.Column="2" Background="#FF252525" Padding="6 4">
            <DockPanel>
                <Button x:Name="BtnRemoteUp" DockPanel.Dock="Left" Content="↑" Width="28" Height="24"
                        Click="OnRemoteUp" ToolTip="Parent directory - drag files here to move up"
                        Margin="0 0 6 0" AllowDrop="True"
                        DragOver="OnUpDragOver" DragLeave="OnUpDragLeave" Drop="OnUpDrop"/>
                <TextBlock DockPanel.Dock="Left" Text="Kronos: " Foreground="#FF88AADD"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="RemotePathBox" Style="{StaticResource PathTextStyle}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Row 1: File lists ──────────────────────────────────────── -->
        <ListView Grid.Row="1" Grid.Column="0" x:Name="LocalList"
                  SelectionMode="Extended"
                  MouseDoubleClick="OnLocalDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name (Local)" Width="220"
                                    CellTemplate="{StaticResource NameCell}"/>
                    <GridViewColumn Header="Size" Width="70"
                                    DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="130"
                                    DisplayMemberBinding="{Binding DateText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="#FF444444"/>

        <ListView Grid.Row="1" Grid.Column="2" x:Name="RemoteList"
                  SelectionMode="Extended"
                  MouseDoubleClick="OnRemoteDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name (Kronos)" Width="220"
                                    CellTemplate="{StaticResource NameCell}"/>
                    <GridViewColumn Header="Size" Width="70"
                                    DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="130"
                                    DisplayMemberBinding="{Binding DateText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ── Row 2: Per-pane toolbars ──────────────────────────────── -->
        <Border Grid.Row="2" Grid.Column="0" Background="#FF252525"
                BorderBrush="#FF444444" BorderThickness="0 1 0 0" Padding="6 4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnUpload"         Content="→ Send to Kronos" Click="OnUpload" Margin="0 0 4 0"
                        ToolTip="Upload selected local files to Kronos"/>
                <Button x:Name="BtnLocalNewFolder" Content="New Folder"       Click="OnLocalNewFolder" Margin="0 0 4 0"/>
                <Button x:Name="BtnLocalDelete"    Content="Delete"           Click="OnLocalDelete" Margin="0 0 4 0"/>
                <Button x:Name="BtnLocalRename"    Content="Rename"           Click="OnLocalRename" Margin="0 0 4 0"/>
                <Button x:Name="BtnLocalRefresh"   Content="↺"               Click="OnLocalRefresh"
                        Width="32" Margin="0" ToolTip="Refresh"/>
            </StackPanel>
        </Border>
        <Rectangle Grid.Row="2" Grid.Column="1" Fill="#FF444444"/>
        <Border Grid.Row="2" Grid.Column="2" Background="#FF252525"
                BorderBrush="#FF444444" BorderThickness="0 1 0 0" Padding="6 4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnDownload"        Content="← Send to PC"   Click="OnDownload" Margin="0 0 4 0"
                        ToolTip="Download selected Kronos files to local"/>
                <Button x:Name="BtnRemoteNewFolder" Content="New Folder"      Click="OnRemoteNewFolder" Margin="0 0 4 0"/>
                <Button x:Name="BtnRemoteDelete"    Content="Delete"          Click="OnRemoteDelete" Margin="0 0 4 0"/>
                <Button x:Name="BtnRemoteRename"    Content="Rename"          Click="OnRemoteRename" Margin="0 0 4 0"/>
                <Button x:Name="BtnRemoteRefresh"   Content="↺"              Click="OnRemoteRefresh"
                        Width="32" Margin="0" ToolTip="Refresh"/>
            </StackPanel>
        </Border>

        <!-- ── Row 3: Status bar ──────────────────────────────────────── -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#FF1A1A1A" BorderBrush="#FF444444"
                BorderThickness="0 1 0 0" Padding="6 3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Foreground="#FFCCCCCC" VerticalAlignment="Center" Text="Ready"/>
                <ProgressBar x:Name="TransferProgress" Grid.Column="1"
                             Height="12" Margin="4 0 0 0"
                             Foreground="#FF88AADD" Background="#FF333333"
                             BorderBrush="#FF555555"
                             Visibility="Collapsed" Minimum="0" Maximum="100"/>
            </Grid>
        </Border>
    </Grid>
</local:ThemedWindow>
