<local:ThemedWindow x:Class="KronosScreenRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Kronos ScreenRemote"
        Width="1870" Height="625"
        ResizeMode="CanResize"
        Focusable="True"
        Icon="/Resources/Icons/AppIcon.ico">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="MENU_File" Header="_File">
                <MenuItem x:Name="MNU_SettingsDlg"    Header="_Settings..."/>
                <Separator/>
                <MenuItem x:Name="MNU_ImportSettings" Header="_Import Settings..."
                          ToolTip="Load application settings from a .json file and apply them now."/>
                <MenuItem x:Name="MNU_ExportSettings" Header="_Export Settings..."
                          ToolTip="Save the current application settings to a .json file."/>
                <Separator/>
                <MenuItem x:Name="MNU_Screenshot"  Header="Sa_ve Screenshot..."        InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MNU_QuickSave"   Header="Q_uick Save Screenshot"/>
                <MenuItem x:Name="MNU_CopyFrame"   Header="_Copy Frame to Clipboard"/>
                <MenuItem x:Name="MNU_OpenScreenshotsFolder" Header="Open Screenshots _Folder"/>
                <Separator/>
                <MenuItem x:Name="MNU_OpenLog"     Header="Open _Log File"/>
                <Separator/>
                <MenuItem x:Name="MNU_Quit"        Header="_Quit"/>
            </MenuItem>
            <MenuItem x:Name="MENU_Connection" Header="_Connection">
                <MenuItem x:Name="MNU_Reconnect"   Header="_Connect"/>
                <MenuItem x:Name="MNU_Disconnect"  Header="_Disconnect" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="MENU_RecentHosts" Header="_Recent Connections">
                    <MenuItem x:Name="MNU_NoRecentHosts" Header="(none)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="MNU_CopyIP" Header="Copy _IP Address"/>
            </MenuItem>
            <MenuItem x:Name="MENU_View" Header="_View">
                <MenuItem x:Name="MNU_Zoom"          Header="_Zoom Window"      IsCheckable="True"/>
                <Separator/>
                <MenuItem x:Name="MNU_Fullscreen"    Header="_Fullscreen"/>
                <MenuItem x:Name="MNU_HideDataInput"  Header="Hide _Data Input"   IsCheckable="True"/>
                <MenuItem x:Name="MNU_HideValueInput" Header="Hide _Value Input"  IsCheckable="True"/>
                <MenuItem x:Name="MNU_AlwaysOnTop"   Header="Always on _Top"   IsCheckable="True"/>
                <MenuItem x:Name="MNU_RefreshDisplay" Header="_Refresh Display"/>
                <Separator/>
                <MenuItem x:Name="MENU_ScalingMode" Header="Scaling _Quality"
                          ToolTip="How the 800×600 screen is scaled up to the window.">
                    <MenuItem x:Name="MNU_ScaleSharp"  Header="_Sharp (crisp pixels)"   IsCheckable="True"
                              ToolTip="Nearest-neighbor - blocky but razor-sharp; no interpolation."/>
                    <MenuItem x:Name="MNU_ScaleSmooth" Header="S_mooth (bilinear)"      IsCheckable="True"
                              ToolTip="Bilinear - soft and fast."/>
                    <MenuItem x:Name="MNU_ScaleHQ"     Header="_High Quality (default)" IsCheckable="True"
                              ToolTip="Fant resampling - best quality (default)."/>
                </MenuItem>
                <MenuItem x:Name="MNU_ImageAdjust" Header="_Image Adjustments..."
                          ToolTip="Brightness, contrast, gamma, saturation, and sharpening."/>
                <Separator/>
                <MenuItem x:Name="MENU_LayoutPreset" Header="Layout _Preset">
                    <MenuItem x:Name="MNU_PresetFull"    Header="_Full"    IsCheckable="True"
                              ToolTip="Frame + full controls panel (default)"/>
                    <MenuItem x:Name="MNU_PresetFocused" Header="F_ocused" IsCheckable="True"
                              ToolTip="Frame fills window; controls collapse to a narrow rail"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MENU_WinSize" Header="Window _Size">
                    <MenuItem x:Name="MNU_Size75"  Header="_Small (75%)"        IsCheckable="True" InputGestureText="Ctrl+1"/>
                    <MenuItem x:Name="MNU_Size100" Header="_Normal (100%)"      IsCheckable="True" InputGestureText="Ctrl+2"/>
                    <MenuItem x:Name="MNU_Size125" Header="_Large (125%)"       IsCheckable="True" InputGestureText="Ctrl+3"/>
                    <MenuItem x:Name="MNU_Size150" Header="_Extra Large (150%)" IsCheckable="True" InputGestureText="Ctrl+4"/>
                    <MenuItem x:Name="MNU_Size200" Header="_Huge (200%)"        IsCheckable="True" InputGestureText="Ctrl+5"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="MENU_Tools" Header="_Tools">
                <MenuItem x:Name="MNU_PaletteEd"  Header="_Palette Editor"  IsCheckable="True"/>
                <MenuItem x:Name="MNU_CalMode"    Header="_Calibration"      IsCheckable="True"/>
                <MenuItem x:Name="MNU_KbdWarp"    Header="Enable _Warp Mode" IsCheckable="True"/>
                <MenuItem x:Name="MENU_CalGrid"   Header="Calibration _Grid Size">
                    <MenuItem x:Name="MNU_CalGrid3" Header="_3×3" IsCheckable="True"/>
                    <MenuItem x:Name="MNU_CalGrid4" Header="_4×4" IsCheckable="True"/>
                    <MenuItem x:Name="MNU_CalGrid5" Header="_5×5" IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MNU_SysExTool"    Header="_MIDI Monitor..."/>
                <MenuItem x:Name="MNU_Librarian"    Header="_Librarian..."
                          ToolTip="Local editable library copy - Sync/Commit with the Kronos, load a .pcg file to compare and drag objects in, edit names/categories/Set List slots."/>
                <MenuItem x:Name="MNU_SampleEditor" Header="Sample _Editor..."
                          ToolTip="View/edit .KSC/.KMP/.KSF sample content on disk - key range, loop points, sample rate."/>
                <MenuItem x:Name="MNU_FileManager" Header="_File Manager..."/>
                <Separator/>
                <MenuItem x:Name="MNU_KeyboardInfo" Header="_Keyboard Info..."/>
                <MenuItem x:Name="MNU_InputTester"  Header="_Input Tester..." Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_TestMode"     Header="Enter Kronos _Test Mode"/>
                <Separator/>
                <MenuItem x:Name="MNU_DisableKbd"   Header="_Disable Remote Typing" IsCheckable="True" ToolTip="Disable sending keystrokes to the Kronos. All keyboard input remains local."/>
            </MenuItem>
            <MenuItem x:Name="MENU_ModeSelect" Header="_Mode Select">
                <!-- Kronos item set - visible for Kronos/Unknown, collapsed for Nautilus (toggled
                     in ApplyDeviceFamilyUi, same pattern as KronosControlGrid/NautilusControlGrid). -->
                <MenuItem x:Name="MNU_Mode_Setlist"  Header="_Setlist"/>
                <MenuItem x:Name="MNU_Mode_Combi"    Header="_Combi"/>
                <MenuItem x:Name="MNU_Mode_Program"  Header="_Program"/>
                <MenuItem x:Name="MNU_Mode_Sequence" Header="S_equence"/>
                <MenuItem x:Name="MNU_Mode_Sampling" Header="S_ampling"/>
                <MenuItem x:Name="MNU_Mode_Global"   Header="_Global"/>
                <MenuItem x:Name="MNU_Mode_Disk"     Header="_Disk"/>
                <!-- Nautilus item set - the 7 Kronos-named modes above don't exist as such on
                     Nautilus; these mirror the front panel's own Mode/Page/A-F buttons instead
                     (same wire tokens - see MainWindow.xaml.cs's WireButtons/BuildCommandRegistry). -->
                <MenuItem x:Name="MNU_NautilusMode_Mode" Header="_Mode" Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_Page" Header="_Page" Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_A"    Header="_A"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_B"    Header="_B"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_C"    Header="_C"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_D"    Header="_D"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_E"    Header="_E"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_NautilusMode_F"    Header="_F"    Visibility="Collapsed"/>
            </MenuItem>
            <MenuItem x:Name="MENU_BankSelect" Header="Ban_k Select"/>
            <MenuItem Header="_Help">
                <MenuItem x:Name="MNU_ShowHelp"          Header="_Show Help"/>
                <MenuItem x:Name="MNU_CommandPalette"    Header="_Command Palette"      InputGestureText="Ctrl+K"/>
                <Separator/>
                <MenuItem x:Name="MNU_About"             Header="_About..."/>
                <!-- Future: Check for Updates / Report Issue - hidden until a public release pipeline exists -->
                <Separator x:Name="SEP_HelpExternal"    Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_CheckForUpdates"  Header="Check for _Updates..."   Visibility="Collapsed"/>
                <MenuItem x:Name="MNU_ReportIssue"      Header="_Report Issue..."        Visibility="Collapsed"/>
            </MenuItem>
        </Menu>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <!-- Two stacked rows rather than one: UpdateStatusBarWrap (MainWindow.xaml.cs) moves
             RightClusterHost - everything below still marked DockPanel.Dock="Right" - down into
             AppStatusBarRow2 whenever the window is too narrow to show both groups on one line,
             the status-bar equivalent of word-wrap. Row2 starts collapsed/empty; on a wide
             window RightClusterHost stays up here and row2 is never shown. -->
        <StackPanel x:Name="StatusBarStack" DockPanel.Dock="Bottom">
        <StatusBar x:Name="AppStatusBar"
                   Background="#FF1A1A1A"
                   MinHeight="28"
                   Padding="0">
            <StatusBar.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <!-- Flat, non-focusable icon button for the footer sequencer transport row.
                     Focusable=False + null FocusVisualStyle so a click never steals the
                     keyboard-send focus (matches VuPickerBtn). -->
                <Style x:Key="SeqTransportBtn" TargetType="Button">
                    <Setter Property="Focusable"        Value="False"/>
                    <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                    <Setter Property="Cursor"            Value="Hand"/>
                    <Setter Property="Width"             Value="24"/>
                    <Setter Property="Height"            Value="20"/>
                    <Setter Property="Background"        Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF454545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- Dimmed, not hidden, when the current mode doesn't support this button -
                         keeps the footer's width/layout stable across the frequent mode switches
                         this app is built around, instead of reflowing the status bar every time. -->
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- Toggle variant of the flat seq-transport button: Record/Start need to
                     stay visibly depressed while active, not just while the mouse is down. -->
                <Style x:Key="SeqTransportToggleBtn" TargetType="ToggleButton">
                    <Setter Property="Focusable"        Value="False"/>
                    <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                    <Setter Property="Cursor"            Value="Hand"/>
                    <Setter Property="Width"             Value="24"/>
                    <Setter Property="Height"            Value="20"/>
                    <Setter Property="Background"        Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF454545"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF454545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- See SeqTransportBtn - dimmed, not hidden, outside a supported mode. -->
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- Same toggle look, but a pale red checked-state (instead of the neutral
                     gray above) so an armed recording reads clearly at a glance. -->
                <Style x:Key="SeqRecordToggleBtn" TargetType="ToggleButton" BasedOn="{StaticResource SeqTransportToggleBtn}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF454545"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF6E3535"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Same as SeqTransportToggleBtn, minus the IsChecked trigger - used for
                     BTN_SeqRec/BTN_SeqStart on Nautilus, where IsPlaying/IsRecording are only
                     ever the client's own optimistic guess (no daemon confirmation exists for
                     them there), so showing a "lit/armed" state would be misleading. Swapped in
                     by ApplyDeviceFamilyUi; the button stays clickable, just never shows
                     checked. -->
                <Style x:Key="SeqTransportToggleBtnNoLight" TargetType="ToggleButton" BasedOn="{StaticResource SeqTransportToggleBtn}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF454545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StatusBar.Resources>
            <!-- Right-aligned items must be declared BEFORE fill items in DockPanel. Each of the
                 six Sec_* groups below (Mode, StreamMode, Vu, SeqTransport, TapTempo, Save) is its
                 own movable unit - UpdateStatusBarWrap (MainWindow.xaml.cs) relocates them to
                 AppStatusBarRow2 one at a time, starting from Sec_Save, as the window narrows, so
                 the footer wraps section-by-section instead of all six moving together. Each
                 wrapper nests its content one DockPanel deeper purely so its own trailing
                 Separator travels with it as one atomic unit; every item's own
                 DockPanel.Dock="Right" still applies exactly as before, now against that inner
                 DockPanel instead of AppStatusBar's directly. -->
            <StatusBarItem x:Name="Sec_Mode" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem DockPanel.Dock="Right" Padding="4 0 8 0">
                <TextBlock x:Name="ModeText" Foreground="#FF88AADD" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="Current Kronos display mode - right-click to change">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CTX_Mode_Setlist"  Header="_Setlist"/>
                            <MenuItem x:Name="CTX_Mode_Combi"    Header="_Combi"/>
                            <MenuItem x:Name="CTX_Mode_Program"  Header="_Program"/>
                            <MenuItem x:Name="CTX_Mode_Sequence" Header="S_equence"/>
                            <MenuItem x:Name="CTX_Mode_Sampling" Header="S_ampling"/>
                            <MenuItem x:Name="CTX_Mode_Global"   Header="_Global"/>
                            <MenuItem x:Name="CTX_Mode_Disk"     Header="_Disk"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <StatusBarItem x:Name="Sec_StreamMode" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem DockPanel.Dock="Right" Padding="4 0">
                <TextBlock x:Name="ConnModeText" Foreground="#FF666666" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="Streaming mode (Pull = server pushes every frame; Change = server pushes on screen change)"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <StatusBarItem x:Name="Sec_Vu" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem DockPanel.Dock="Right" Padding="2 0" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:VuMeterBar x:Name="VuMeter"
                                      Width="110" Height="14"
                                      Cursor="Hand"
                                      ToolTip="Audio output levels - click to reset clip latch"
                                      Margin="0 0 3 0"/>
                    <ToggleButton x:Name="VuPickerBtn"
                                  Content="▾"
                                  Width="13" Height="13"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#FF666666"
                                  FontSize="9"
                                  Padding="0"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  ToolTip="Select audio input device"/>
                    <Popup x:Name="VuPickerPopup"
                           PlacementTarget="{Binding ElementName=VuPickerBtn}"
                           Placement="Top"
                           StaysOpen="False">
                        <Border Background="#FF1E1E1E"
                                BorderBrush="#FF444444"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Audio Input Device"
                                           Padding="8 5 8 3"
                                           Foreground="#FF888888"
                                           FontFamily="Consolas"
                                           FontSize="10"/>
                                <Separator Background="#FF333333" Margin="0"/>
                                <ListBox x:Name="VuDeviceList"
                                         Background="#FF1E1E1E"
                                         Foreground="#FFCCCCCC"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         MinWidth="260"
                                         MaxHeight="200"
                                         Padding="0 2">
                                    <!-- Explicit content alignment overrides the default ListBoxItem
                                         style's FindAncestor(ItemsControl) alignment binding, which
                                         fails (and logs a data-binding error) because this list lives
                                         inside a Popup whose items are realized before the item is
                                         connected to its ItemsControl ancestor. -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <!-- ── Sequencer transport ───────────────────────────────────────────
                 Panel-button emulation: each sends "BUTTON SEQ_*" over the ctrl port,
                 which the daemon converts to a front-panel SEQUENCER key press. -->
            <!-- DataContext = SeqTransportViewModel (set in MainWindow's constructor) -
                 everything below binds Command/IsChecked/IsEnabled to it directly. -->
            <StatusBarItem x:Name="Sec_SeqTransport" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem x:Name="SeqTransportBarItem" DockPanel.Dock="Right" Padding="2 0" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                IsEnabled="{Binding IsTransportEnabled}"
                                ToolTip="Sequencer transport - sends the front-panel SEQUENCER buttons to the Kronos">
                        <Button x:Name="BTN_SeqLocate" Style="{StaticResource SeqTransportBtn}"
                                TabIndex="280" AutomationProperties.Name="Locate"
                                ToolTip="Locate - return to the locate point">
                            <Path Fill="#FFB4B4B4" Data="M0,0 H1.8 V10 H0 Z M10,0 L3,5 L10,10 Z"/>
                        </Button>
                        <Button x:Name="BTN_SeqRew" Style="{StaticResource SeqTransportBtn}"
                                TabIndex="290" AutomationProperties.Name="Rewind"
                                ToolTip="Rewind (&lt;&lt;)">
                            <Path Fill="#FFB4B4B4" Data="M5,0 L0,5 L5,10 Z M10,0 L5,5 L10,10 Z"/>
                        </Button>
                        <Button x:Name="BTN_SeqFf" Style="{StaticResource SeqTransportBtn}"
                                TabIndex="300" AutomationProperties.Name="Fast-forward"
                                ToolTip="Fast-forward (&gt;&gt;)">
                            <Path Fill="#FFB4B4B4" Data="M0,0 L5,5 L0,10 Z M5,0 L10,5 L5,10 Z"/>
                        </Button>
                        <Button x:Name="BTN_SeqPause" Style="{StaticResource SeqTransportBtn}"
                                TabIndex="310" AutomationProperties.Name="Pause"
                                ToolTip="Pause">
                            <Path Fill="#FFB4B4B4" Data="M0.5,0 H3 V10 H0.5 Z M6,0 H8.5 V10 H6 Z"/>
                        </Button>
                        <ToggleButton x:Name="BTN_SeqRec" Style="{StaticResource SeqRecordToggleBtn}"
                                IsChecked="{Binding IsRecording, Mode=TwoWay}"
                                Command="{Binding RecordCommand}"
                                TabIndex="320" AutomationProperties.Name="Record"
                                ToolTip="Record">
                            <Ellipse Width="10" Height="10" Fill="#FFE05656"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BTN_SeqStart" Style="{StaticResource SeqTransportToggleBtn}"
                                IsChecked="{Binding IsPlaying, Mode=TwoWay}"
                                Command="{Binding StartStopCommand}"
                                TabIndex="330" AutomationProperties.Name="Start / Stop"
                                ToolTip="Start / Stop">
                            <Grid>
                                <Path Fill="#FF5EC26A" Data="M0.5,0 L10,5 L0.5,10 Z"
                                      Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"/>
                                <Path Fill="#FF5EC26A" Data="M1,1 H9 V9 H1 Z"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <!-- The status-bar Inc/Dec stand-in (NautilusValueBarItem) that used to live here is
                 retired - now that the Nautilus front panel has its own Data Inc/Dec buttons
                 (NautilusRightPanel.xaml), the status-bar duplicate is redundant. Per-family
                 direction, 2026-09-21. -->
            <!-- ── Tap tempo ─────────────────────────────────────────────────────
                 Its own section beside the transport row. A single momentary press
                 sends "BUTTON TAP_TEMPO" over the ctrl port; the daemon injects the
                 front-panel TAP TEMPO key and the Kronos averages successive taps
                 itself (two taps set the tempo), exactly like the hardware button.
                 Global - tempo applies in every mode, not just Sequence - so it's
                 enabled on connection from code-behind, not by IsTransportEnabled.
                 Click + the "Tap Tempo" keybind both route through the command
                 registry; each tap briefly flashes the button (FlashTapTempo). -->
            <StatusBarItem x:Name="Sec_TapTempo" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem x:Name="TapTempoBarItem" DockPanel.Dock="Right" Padding="2 0" VerticalContentAlignment="Center">
                <Button x:Name="BTN_TapTempo" Style="{StaticResource SeqTransportBtn}"
                        Width="30" Height="24" IsEnabled="False"
                        TabIndex="340" AutomationProperties.Name="Tap Tempo"
                        ToolTip="Tap Tempo - tap in quarter-notes to set the Kronos tempo (two taps is enough)">
                    <Path Fill="#FFB4B4B4" Width="12" Height="12" Stretch="Uniform"
                          Data="F0 M3,0 L7,0 L9.5,10 L0.5,10 Z M5.3,2 L6.2,2 L4.7,8 L3.8,8 Z"/>
                </Button>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <!-- Save/Write: on Kronos, fires the same REC/WRITE key press as Record (one physical
                 key that means Record in Sequence mode and Write everywhere else it applies) - a
                 separate SaveCommand from Record's, but sending the identical wire token there
                 (see SeqTransportViewModel). On Nautilus this is a genuinely different physical
                 button (front-panel "F", wire EXIT - your QA slot F is programmed as Write/Save;
                 see SeqTransportViewModel.Save's own comment), hence the separate command rather
                 than sharing RecordCommand outright. Its own StatusBarItem (not nested in
                 SeqTransportBarItem) since its enabled modes don't overlap with Sequence. -->
            <StatusBarItem x:Name="Sec_Save" DockPanel.Dock="Right" Padding="0">
            <DockPanel LastChildFill="False">
            <StatusBarItem x:Name="SeqSaveBarItem" DockPanel.Dock="Right" Padding="2 0" VerticalContentAlignment="Center">
                <Button x:Name="BTN_SeqSave" Style="{StaticResource SeqTransportBtn}"
                        Width="30" Height="24"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaveEnabled}"
                        TabIndex="350" AutomationProperties.Name="Write / Save"
                        ToolTip="Write - Save your changes (Setlist/Combi/Program/Global)">
                    <Path Fill="#FFB4B4B4" Width="12" Height="12" Stretch="Uniform"
                          Data="M0,0 H8 L10,2 V10 H0 Z M2,0 H6 V3 H2 Z"/>
                </Button>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="2 4" Background="#FF444444" Width="1"/>
            </DockPanel>
            </StatusBarItem>
            <StatusBarItem Padding="8 0 4 0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CTX_StatusReconnect"  Header="_Reconnect"/>
                            <MenuItem x:Name="CTX_StatusDisconnect" Header="_Disconnect"/>
                            <Separator/>
                            <MenuItem x:Name="CTX_StatusCopyIP"     Header="Copy _IP Address"/>
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0 0 6 0"
                             VerticalAlignment="Center" Fill="#FF444444"/>
                    <TextBlock x:Name="StatusText" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Text="Not connected"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="4 0" VerticalContentAlignment="Center">
                <Grid x:Name="KbdStatusGrid" Width="16" Height="13"
                      ToolTip="Keyboard: click screen panel to capture">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CTX_KbdEnable"  Header="_Enable Remote Typing"/>
                            <MenuItem x:Name="CTX_KbdDisable" Header="_Disable Remote Typing"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <TextBlock x:Name="KbdStatusIcon" Text="⌨"
                               FontFamily="Segoe UI Symbol" FontSize="11"
                               Foreground="#FF555555"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Line x:Name="KbdStatusSlash"
                          X1="1" Y1="12" X2="15" Y2="1"
                          Stroke="#FF555555" StrokeThickness="1.5"
                          SnapsToDevicePixels="True"/>
                </Grid>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="4 0">
                <TextBlock x:Name="FpsText" Foreground="#FF666666" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="Frames per second - right-click to adjust target">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CTX_SetMaxFps" Header="Set _Max FPS..."/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="4 0">
                <TextBlock x:Name="PingText" Foreground="#FF666666" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="Round-trip network latency to Kronos"/>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <!-- Active MIDI link badge: USB (native, fast) / DIN (5-pin interface, slow) / TCP (network). -->
            <StatusBarItem Padding="4 0" VerticalContentAlignment="Center">
                <Border x:Name="MidiLinkBadgeBorder" CornerRadius="3" Padding="5 1"
                        BorderThickness="1" BorderBrush="#FF444444" Background="#FF202020"
                        VerticalAlignment="Center"
                        ToolTip="Active MIDI link - USB: Kronos native USB (fast); DIN: 5-pin MIDI interface (slow); TCP: network daemon.">
                    <TextBlock x:Name="MidiLinkBadge" Text="-" FontSize="10" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="#FF777777" VerticalAlignment="Center"/>
                </Border>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="3 0" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="SysEx in/out. Green is received by client, Blue is transmitted from client.">
                    <!-- RX: down-arrow + green dot -->
                    <TextBlock x:Name="SysExRxArrow" Text="↓" FontSize="16"
                               Foreground="#FF2A3A2A" VerticalAlignment="Center"
                               Margin="0 0 1 0" FontFamily="Segoe UI"/>
                    <Ellipse x:Name="SysExRxDot" Width="12" Height="12"
                             Fill="#FF2A3A2A" VerticalAlignment="Center"
                             Margin="0 0 4 0"/>
                    <!-- TX: Red dot + up-arrow -->
                    <Ellipse x:Name="SysExTxDot" Width="12" Height="12"
                             Fill="#FF3A2A2A" VerticalAlignment="Center"
                             Margin="0 0 1 0"/>
                    <TextBlock x:Name="SysExTxArrow" Text="↑" FontSize="16"
                               Foreground="#FF3A2A2A" VerticalAlignment="Center"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <!-- Notification bubble: faded gray at rest, red on error.
                     Border with Transparent background keeps the hit area solid. -->
                <Border x:Name="NotifyBubble"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="Click to open log">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CTX_OpenLogFile"        Header="Open _Log..."/>
                            <MenuItem x:Name="CTX_ClearLogs"          Header="Clear _Logs"
                                      ToolTip="Truncate the current log file. Cannot be undone."/>
                            <MenuItem x:Name="CTX_ClearNotification"  Header="_Clear Notification"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Path x:Name="NotifyBubblePath"
                          Width="14" Height="13"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="#FFB4B4B4"
                          Data="M 1.5,0 L 12,0 Q 14,0 14,2 L 14,8.5 Q 14,10 12,10 L 5.5,10 L 2.5,13 L 3.5,10 L 2,10 Q 0,10 0,8.5 L 0,2 Q 0,0 1.5,0 Z"/>
                </Border>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <Border x:Name="KbdInfoBtn"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="Keyboard Info">
                    <TextBlock Text="&#xE147;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="18"
                               Foreground="#FFB4B4B4"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </StatusBarItem>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <Border x:Name="LibrarianStatusBtn"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="Librarian"
                        AutomationProperties.Name="Librarian">
                    <!-- Single open book - two pages splayed from a center spine. -->
                    <Path Width="14" Height="13" Stretch="Uniform" Fill="#FFB4B4B4"
                          Data="M 7,3 C 5,1.5 2,1 0,1.5 L 0,11.5 C 2,11 5,11.5 7,13
                                C 9,11.5 12,11 14,11.5 L 14,1.5 C 12,1 9,1.5 7,3 Z"/>
                </Border>
            </StatusBarItem>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <Border x:Name="FileTransferStatusBtn"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="File Transfer"
                        AutomationProperties.Name="File Transfer">
                    <!-- Folder with the tab at the top-left, matching the default Windows folder icon. -->
                    <Polygon Points="1,1 7,1 8,3 14,3 14,11 0,11 0,3" Fill="#FFB4B4B4"/>
                </Border>
            </StatusBarItem>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <Border x:Name="SampleEditorStatusBtn"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="Sample Editor"
                        AutomationProperties.Name="Sample Editor">
                    <!-- Waveform: five bars of varying height, tallest in the middle. -->
                    <Canvas Width="14" Height="13">
                        <Rectangle Canvas.Left="0"  Canvas.Top="5" Width="2" Height="3"  Fill="#FFB4B4B4"/>
                        <Rectangle Canvas.Left="3"  Canvas.Top="2" Width="2" Height="9"  Fill="#FFB4B4B4"/>
                        <Rectangle Canvas.Left="6"  Canvas.Top="4" Width="2" Height="5"  Fill="#FFB4B4B4"/>
                        <Rectangle Canvas.Left="9"  Canvas.Top="0" Width="2" Height="13" Fill="#FFB4B4B4"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="4" Width="2" Height="5"  Fill="#FFB4B4B4"/>
                    </Canvas>
                </Border>
            </StatusBarItem>
            <StatusBarItem Padding="2 0" VerticalContentAlignment="Center">
                <Border x:Name="MidiMonitorStatusBtn"
                        Cursor="Hand"
                        Background="Transparent"
                        Padding="2 1"
                        VerticalAlignment="Center"
                        ToolTip="MIDI Monitor"
                        AutomationProperties.Name="MIDI Monitor">
                    <!-- Mini piano: five white keys, three black keys overlaid (C-D#, D-D#, F-F# pattern). -->
                    <Canvas Width="15" Height="13">
                        <Rectangle Canvas.Left="0"  Canvas.Top="0" Width="3" Height="13" Fill="#FFB4B4B4" Stroke="#FF262626" StrokeThickness="0.5"/>
                        <Rectangle Canvas.Left="3"  Canvas.Top="0" Width="3" Height="13" Fill="#FFB4B4B4" Stroke="#FF262626" StrokeThickness="0.5"/>
                        <Rectangle Canvas.Left="6"  Canvas.Top="0" Width="3" Height="13" Fill="#FFB4B4B4" Stroke="#FF262626" StrokeThickness="0.5"/>
                        <Rectangle Canvas.Left="9"  Canvas.Top="0" Width="3" Height="13" Fill="#FFB4B4B4" Stroke="#FF262626" StrokeThickness="0.5"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="0" Width="3" Height="13" Fill="#FFB4B4B4" Stroke="#FF262626" StrokeThickness="0.5"/>
                        <Rectangle Canvas.Left="2"  Canvas.Top="0" Width="2" Height="8" Fill="#FF1A1A1A"/>
                        <Rectangle Canvas.Left="5"  Canvas.Top="0" Width="2" Height="8" Fill="#FF1A1A1A"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="0" Width="2" Height="8" Fill="#FF1A1A1A"/>
                    </Canvas>
                </Border>
            </StatusBarItem>
            <Separator Margin="2 4" Background="#FF444444" Width="1"/>
            <StatusBarItem x:Name="PerfStatusBarItem" Padding="4 0">
                <TextBlock Foreground="#FF88AADD" FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding PerformanceDisplay}"
                           ToolTip="Current performance - bank, number, and name (via SysEx). Right-click to pull from the Kronos.">
                    <TextBlock.ContextMenu>
                        <ContextMenu x:Name="CTX_PerfPullMenu">
                            <MenuItem Header="_Pull names from Kronos...">
                                <MenuItem x:Name="CTX_PullThisProgram" Header="This _Program"
                                          ToolTip="Pull only the program/combi currently showing."/>
                                <MenuItem x:Name="CTX_PullThisBank"    Header="This _Bank"
                                          ToolTip="Pull every object in the current bank."/>
                                <MenuItem x:Name="CTX_PullThisMode"    Header="This _Mode"
                                          ToolTip="Pull every bank of the current object type."/>
                                <Separator/>
                                <MenuItem x:Name="CTX_PullAll"         Header="_All"
                                          ToolTip="Full library pull - every program, combi, set list, drum kit, and wave sequence."/>
                            </MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <!-- Overflow row - empty and collapsed until UpdateStatusBarWrap moves RightClusterHost
             into it. Its own ItemsPanel (default DockPanel, LastChildFill honors the single
             item's Dock="Right") puts that cluster flush against the right edge here too. -->
        <StatusBar x:Name="AppStatusBarRow2"
                   Background="#FF1A1A1A"
                   MinHeight="28"
                   Padding="0"
                   Visibility="Collapsed"/>
        </StackPanel>

        <Grid x:Name="OuterGrid" Background="{StaticResource WindowBackgroundBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="282*"/>
                <ColumnDefinition x:Name="MainAreaColumn" Width="1600*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left value-slider panel (column 0) ─────────────────────── -->
            <!-- Kronos-only content lives in KronosLeftPanel (UserControl); Content is set
                 (or null, on Nautilus) in ApplyDeviceFamilyUi - see that file's header comment. -->
            <ContentControl x:Name="LeftPanelHost" Grid.Column="0" Focusable="False"/>

        <Grid x:Name="RootGrid" Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="173*"/>
                <ColumnDefinition Width="627*"/>
                <ColumnDefinition x:Name="ControlsColumn" Width="800*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Screen area (columns 0+1) ──────────────────────────────── -->
            <Image x:Name="FrameImage"
               Stretch="Fill"
               SnapsToDevicePixels="False"
               Grid.ColumnSpan="2">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CTX_CopyFrame"       Header="_Copy Frame to Clipboard"/>
                        <MenuItem x:Name="CTX_QuickSave"       Header="Q_uick Save Screenshot"/>
                        <MenuItem x:Name="CTX_Screenshot"      Header="Save _Screenshot..." InputGestureText="Ctrl+S"/>
                        <MenuItem x:Name="CTX_OpenScreenshots" Header="Open Screenshots Fo_lder"/>
                        <Separator/>
                        <MenuItem x:Name="CTX_ZoomIn"          Header="Zoom I_n"/>
                        <MenuItem x:Name="CTX_ZoomOut"         Header="Zoom _Out"/>
                        <MenuItem x:Name="CTX_ZoomReset"       Header="_Reset Zoom"/>
                        <Separator/>
                        <MenuItem x:Name="CTX_Fullscreen"      Header="_Fullscreen"  IsCheckable="True"/>
                        <Separator/>
                        <MenuItem x:Name="CTX_ScalingMode" Header="Scaling _Quality">
                            <MenuItem x:Name="CTX_ScaleSharp"  Header="_Sharp (crisp pixels)" IsCheckable="True"/>
                            <MenuItem x:Name="CTX_ScaleSmooth" Header="S_mooth (bilinear)"    IsCheckable="True"/>
                            <MenuItem x:Name="CTX_ScaleHQ"     Header="_High Quality"         IsCheckable="True"/>
                        </MenuItem>
                        <MenuItem x:Name="CTX_ImageAdjust"     Header="_Image Adjustments..."/>
                        <Separator/>
                        <MenuItem x:Name="CTX_KeyboardInfo"    Header="_Keyboard Info..."/>
                        <Separator/>
                        <MenuItem x:Name="CTX_Reconnect"       Header="Reconn_ect"/>
                        <MenuItem x:Name="CTX_Disconnect"      Header="_Disconnect"/>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
            <local:OverlayElement x:Name="OverlayLayer"
                              IsHitTestVisible="False"
                              Grid.ColumnSpan="2"/>

            <!-- ── Control surface (column 2) ─────────────────────────────── -->
            <!-- Kronos-only content lives in KronosRightPanel (UserControl), Nautilus-only in
                 NautilusRightPanel; Content is swapped in ApplyDeviceFamilyUi - see that
                 method's header comment. -->
            <ContentControl x:Name="RightPanelHost" Grid.Column="2" Focusable="False"/>
        </Grid>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
