<local:ThemedWindow x:Class="KronosScreenRemote.LibrarianShellWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KronosScreenRemote.ViewModels"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Librarian"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnUndoCommand" CanExecute="OnCanUndoCommand"/>
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/>
    </Window.InputBindings>
    <Window.Resources>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullToCollapsed"/>
        <local:EmptyStringToNullConverter x:Key="EmptyToNull"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LibraryTreeStyle" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
            <!-- Virtualize container realization. Without this, a large .pcg (thousands of
                 objects) realized one TreeViewItem per node, which froze the UI for ~10s on
                 the FIRST broad search (FilterNode force-expands every matching branch, see
                 PcgPaneViewModel.FilterNode) and again on the next load (ObjectTreeScaffold.
                 Rebuild's roots.Clear() tears those containers down, then RestoreExpandedKeys
                 re-expands them, so WPF re-realizes every one). Recycling bounds realized
                 containers to the viewport, so broad-filter/expand-all/reload all stay
                 O(visible) instead of O(total). Expansion/selection state already lives on the
                 model (ObjectTreeNode.IsExpanded/IsSelected), never on the container, so
                 virtualization can't lose it. -->
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE0E0E0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
            </Style.Resources>
        </Style>

        <Style x:Key="TreeNodeSelectionStyle" TargetType="Border">
            <!-- Transparent, not unset: a Border with a null Background is invisible to hit
                 testing, so before this the only clickable part of a row was the label TextBlock
                 itself - clicks to the right of the text, or in the row's own vertical padding,
                 landed on nothing at all. The row Border carries the mouse handlers now (see the
                 three node templates below), and this is what makes its full width live. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionHighlightBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate x:Key="LocalNodeTemplate" DataType="{x:Type vm:ObjectTreeNode}" ItemsSource="{Binding Children}">
            <!-- Padding is 2 VERTICAL here and 0 on the TreeViewItem (LibraryTreeItemStyle), not
                 the other way round: identical geometry, but the gap between rows now belongs to
                 this Border - which handles clicks - instead of to the TreeViewItem, which does
                 not. That is what removes the dead band between adjacent entries. -->
            <Border Padding="2 2" HorizontalAlignment="Stretch"
                    PreviewMouseLeftButtonDown="OnLocalNodePreviewMouseDown"
                    PreviewMouseLeftButtonUp="OnLocalNodeMouseUp"
                    PreviewMouseRightButtonDown="OnLocalNodePreviewRightDown"
                    PreviewMouseMove="OnLocalNodePreviewMouseMove"
                    ContextMenuOpening="OnLocalContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem x:Name="MI_Cut" Header="Cut" InputGestureText="Ctrl+X" Click="OnCutMenuItem"/>
                        <MenuItem x:Name="MI_Copy" Header="Copy" InputGestureText="Ctrl+C" Click="OnCopyMenuItem"/>
                        <MenuItem x:Name="MI_Paste" Header="Paste" InputGestureText="Ctrl+V" Click="OnPasteMenuItem"/>
                        <Separator x:Name="SEP_MergeMove"/>
                        <MenuItem x:Name="MI_MoveToMerge" Header="Move to Merge Window" Click="OnMoveLocalToMergeMenuItem"
                                  ToolTip="Stage this and its dependencies in the Merge Window."/>
                        <MenuItem x:Name="MI_ScanDeps" Header="Scan PCG for dependencies..." Click="OnScanDependenciesMenuItem"
                                  ToolTip="Search a .pcg for this object's missing dependencies and stage them."/>
                        <Separator x:Name="SEP_1"/>
                        <MenuItem x:Name="MI_Rename" Header="Rename..." InputGestureText="F2" Click="OnRenameMenuItem"/>
                        <MenuItem x:Name="MI_Properties" Header="Properties..." Click="OnOpenProperties"/>
                        <Separator x:Name="SEP_2"/>
                        <MenuItem x:Name="MI_Delete" Header="Delete" InputGestureText="Del" Click="OnDeleteMenuItem"
                                  ToolTip="Deletes from the local library only - hardware is untouched until Commit."/>
                        <Separator/>
                        <MenuItem Header="Expand Selected" Click="OnLocalExpandSelectedMenuItem"/>
                        <MenuItem Header="Collapse Selected" Click="OnLocalCollapseSelectedMenuItem"/>
                        <MenuItem Header="Expand All" Click="OnLocalExpandAllMenuItem"/>
                        <MenuItem Header="Collapse All" Click="OnLocalCollapseAllMenuItem"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource TreeNodeSelectionStyle}">
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsConflicted}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConflictHighlightBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PendingDeleteHighlightBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/>

                    <TextBlock Text="●" FontSize="9" Margin="5 0 0 0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                        <Setter Property="ToolTip" Value="Locally changed - pending Sync/Commit."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="●" FontSize="9" FontWeight="Bold" Margin="5 0 0 0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DependencyStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Foreground" Value="{StaticResource CommittedHighlightBrush}"/>
                                        <Setter Property="ToolTip" Value="All dependencies resolved locally - still pending Sync/Commit."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DependencyStatus}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="!"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                        <Setter Property="ToolTip" Value="Missing one or more dependencies - place them locally before Commit."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="●" FontSize="9" Margin="5 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource SampleDependencyDotBrush}"
                               Visibility="{Binding HasSampleDependency, Converter={StaticResource BoolToVis}}"
                               ToolTip="References a sample - see Object Dependencies for which."/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="PcgNodeTemplate" DataType="{x:Type vm:ObjectTreeNode}" ItemsSource="{Binding Children}">
            <Border Padding="2 2" HorizontalAlignment="Stretch" Style="{StaticResource TreeNodeSelectionStyle}"
                    PreviewMouseLeftButtonDown="OnPcgPreviewMouseDown"
                    PreviewMouseLeftButtonUp="OnPcgNodeMouseUp"
                    PreviewMouseRightButtonDown="OnPcgNodePreviewRightDown"
                    PreviewMouseMove="OnPcgPreviewMouseMove"
                    ContextMenuOpening="OnPcgContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem x:Name="MI_MoveToMerge" Header="Move to Merge Window" Click="OnMoveToMergeMenuItem"/>
                        <Separator/>
                        <MenuItem Header="Expand Selected" Click="OnPcgExpandSelectedMenuItem"/>
                        <MenuItem Header="Collapse Selected" Click="OnPcgCollapseSelectedMenuItem"/>
                        <MenuItem Header="Expand All" Click="OnPcgExpandAllMenuItem"/>
                        <MenuItem Header="Collapse All" Click="OnPcgCollapseAllMenuItem"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/>

                    <TextBlock Text="●" FontSize="9" Margin="5 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource SampleDependencyDotBrush}"
                               Visibility="{Binding HasSampleDependency, Converter={StaticResource BoolToVis}}"
                               ToolTip="References a sample - see Object Dependencies for which."/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="MergeNodeTemplate" DataType="{x:Type vm:ObjectTreeNode}" ItemsSource="{Binding Children}">
            <Border Padding="2 2" HorizontalAlignment="Stretch" Style="{StaticResource TreeNodeSelectionStyle}"
                    PreviewMouseLeftButtonDown="OnMergePreviewMouseDown"
                    PreviewMouseLeftButtonUp="OnMergeNodeMouseUp"
                    PreviewMouseRightButtonDown="OnMergeNodePreviewRightDown"
                    PreviewMouseMove="OnMergePreviewMouseMove"
                    ContextMenuOpening="OnMergeContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem x:Name="MI_RemoveFromMerge" Header="Remove" Click="OnRemoveFromMergeMenuItem"/>
                        <Separator/>
                        <MenuItem Header="Expand Selected" Click="OnMergeExpandSelectedMenuItem"/>
                        <MenuItem Header="Collapse Selected" Click="OnMergeCollapseSelectedMenuItem"/>
                        <MenuItem Header="Expand All" Click="OnMergeExpandAllMenuItem"/>
                        <MenuItem Header="Collapse All" Click="OnMergeCollapseAllMenuItem"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="●" FontSize="9" Margin="5 0 0 0" VerticalAlignment="Center" Foreground="#FFD4C020"
                               Visibility="{Binding SharedTooltip, Converter={StaticResource NullToCollapsed}}"
                               ToolTip="{Binding SharedTooltip}"/>
                    <TextBlock Text="●" FontSize="9" Margin="5 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource SampleDependencyDotBrush}"
                               Visibility="{Binding HasSampleDependency, Converter={StaticResource BoolToVis}}"
                               ToolTip="References a sample - see Object Dependencies for which."/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
        <Style x:Key="LibraryTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- The theme's TreeViewItem gives every row 2px of vertical padding OUTSIDE the
                 header content, which is dead to the mouse. Handing those 2px to the row Border
                 instead (Padding="2 2" in the templates above) keeps the rows exactly where they
                 were while making the band between two entries hit the nearer one. Scoped to the
                 librarian trees rather than the theme so no other TreeView shifts. -->
            <Setter Property="Padding" Value="2 0"/>
        </Style>

        <!-- PCG pane only (TV_Pcg) - collapses whatever the live search filter excludes
             (PcgPaneViewModel.IsVisible/FilterNode). Local/Merge keep LibraryTreeItemStyle
             unchanged: ObjectTreeNode.IsVisible defaults true, so this would be a no-op for them
             anyway, but there's no reason for their trees to even carry the trigger. -->
        <Style x:Key="PcgTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource LibraryTreeItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 8">
            <!-- Docked Right so it sits at the top-right of the window, directly above the
                 "Loaded PCG File" pane (Grid.Column="0" below) - a live filter over that pane's
                 tree only (Local Library/Merge Window are untouched). -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16 0 0 0">
                <TextBlock Text="Search PCG:" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox x:Name="TXT_PcgSearch" Width="220" Margin="6 0 0 0"
                         Text="{Binding PcgPane.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Filters the tree below by name, bank, category, EXi type, or reference."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- Split button: the main half runs SyncMode (its label always NAMES that mode,
                     so a remembered destructive choice can never look like the safe default), the
                     narrow half picks it. Replaces the old Sync Library + Commit Changes pair -
                     Commit Changes was only ever the push half (SyncPipeline.CommitChangesAsync
                     aliases PushAsync), and is now the "Push Only" entry below. -->
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BTN_Sync" MinWidth="104" BorderThickness="0"
                                Content="{Binding SyncButtonLabel}"
                                Command="{Binding SyncLibraryCommand}"
                                ToolTipService.ShowOnDisabled="True" ToolTip="{Binding SyncTooltip}">
                            <Button.Style>
                                <!-- Push Only overwrites the instrument, so it wears the same danger
                                     colours the old Commit Changes button did - losing that with the
                                     button would have made the destructive direction the least
                                     conspicuous one. Pull Only is destructive to LOCAL work only and
                                     always confirms first, so it stays neutral here. -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncModeIsPushOnly}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource DividerBrush}" Margin="0 3"/>
                        <Button x:Name="BTN_SyncMode" Width="20" BorderThickness="0" Background="Transparent"
                                Content="&#x25BE;" Padding="0" Click="OnSyncModeDropdown"
                                ToolTip="Choose sync direction">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Pull Only" IsCheckable="True"
                                              IsChecked="{Binding SyncModeIsPullOnly, Mode=TwoWay}"
                                              ToolTip="Replace the local library with what is on the Kronos. Pending local changes are discarded (you are asked first)."/>
                                    <MenuItem Header="Push Only" IsCheckable="True"
                                              IsChecked="{Binding SyncModeIsPushOnly, Mode=TwoWay}"
                                              ToolTip="Write every pending local change to the Kronos. If the Kronos has changed since the last sync you are asked before overwriting it."/>
                                    <MenuItem Header="2-Way Sync" IsCheckable="True"
                                              IsChecked="{Binding SyncModeIsTwoWay, Mode=TwoWay}"
                                              ToolTip="Pull the library, then push every pending local change."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- Bounds the PULL half only, so it is inert in Push Only - disabled rather than
                     hidden, so the control does not jump around as the mode changes. -->
                <CheckBox Content="Force Full Sync" VerticalAlignment="Center" Margin="10 0 0 0"
                          IsChecked="{Binding ForceFullPull}"
                          IsEnabled="{Binding SyncModeHasPullHalf}"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="Sync every program, combi, and set list, not just what changed. Applies to the pull half only."/>
                <Button x:Name="BTN_Undo" Content="Undo" Padding="10 2" Margin="16 0 0 0"
                        Command="{Binding UndoCommand}" ToolTip="{Binding UndoLabel}"/>
                <TextBlock VerticalAlignment="Center" Margin="16 0 0 0"
                           TextTrimming="CharacterEllipsis" FontWeight="Bold"
                           Text="{Binding StatusText}" ToolTip="{Binding StatusText, Converter={StaticResource EmptyToNull}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Row 1 carries two independent banners stacked, rather than two grid rows: the SysEx
             banner is a persistent condition and the warning below it is per-operation, so both
             can legitimately be up at once. -->
        <StackPanel Grid.Row="1">

        <!-- SysEx-off read-only fallback: the Kronos answered no SysEx, so Sync and Commit are
             disabled and everything else stays live. NOT dismissible - unlike a warning about
             something that already happened, this describes the window's CURRENT capability, and
             it clears itself the moment Re-check gets an answer. -->
        <Border x:Name="BRD_SysExOff" Background="#FF3A1414" BorderBrush="#FFC04040"
                BorderThickness="2" CornerRadius="4" Padding="10" Margin="0 0 0 8"
                Visibility="{Binding SysExUnavailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BTN_RecheckSysEx" Content="Re-check"
                        Margin="10 0 0 0" Padding="10 2" VerticalAlignment="Top"
                        Command="{Binding RecheckSysExCommand}"
                        ToolTip="Ask the Kronos again, after changing GLOBAL &gt; MIDI."/>
                <TextBlock Foreground="#FFFFC0C0" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                           Text="{Binding SysExOffBannerText}"/>
            </DockPanel>
        </Border>

        <!-- Force destructive write (Settings > Librarian): standing state, not an event, so it is
             not dismissible - the setting's whole purpose is that Commit stops asking, which leaves
             this banner as the only thing on screen saying the conflict check is off. -->
        <Border x:Name="BRD_DestructiveWrite" Background="#FF3A1414" BorderBrush="#FFC04040"
                BorderThickness="2" CornerRadius="4" Padding="10" Margin="0 0 0 8"
                Visibility="{Binding ForceDestructiveWrite, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="#FFFFC0C0" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                       Text="{Binding DestructiveWriteBannerText}"/>
        </Border>

        <!-- Conflicts: local changes whose bank moved on the Kronos, so the push excludes them.
             Persistent (it describes standing state, not an event) and carries its own way out,
             because before this the only sign was a silently smaller "Pushed N object(s)." -->
        <Border x:Name="BRD_Conflicts" Background="#FF3A2A10" BorderBrush="#FFC08A20"
                BorderThickness="2" CornerRadius="4" Padding="10" Margin="0 0 0 8"
                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BTN_ResolveConflicts" Content="Resolve Conflicts"
                        Margin="10 0 0 0" Padding="10 2" VerticalAlignment="Top"
                        Command="{Binding ResolveConflictsKeepMineCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Push your copy over the Kronos for every conflicted object."/>
                <TextBlock Foreground="#FFFFE0A0" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                           Text="{Binding ConflictBannerText}"/>
            </DockPanel>
        </Border>

        <!-- Non-refusable ("CHECK:") or refusal ("REFUSE:") warnings from the last Sync/Commit,
             and Auto-Fill's own "nowhere left to put these". Dismissible: a warning that can only
             be cleared by running another operation stays on screen long after it's been read and
             acted on, and then gets ignored on the run where it matters. -->
        <Border x:Name="BRD_Warning" Background="#FF4A3410" BorderBrush="#FFC08A20"
                BorderThickness="2" CornerRadius="4" Padding="10" Margin="0 0 0 8"
                Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BTN_DismissWarning" Content="✕"
                        Width="22" Height="22" Margin="10 0 0 0" Padding="0"
                        VerticalAlignment="Top" Click="OnDismissWarning"
                        Background="Transparent" BorderThickness="0" Foreground="#FFFFE0A0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        ToolTip="Hide this warning. The condition it describes is unchanged."/>
                <TextBlock Foreground="#FFFFE0A0" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                           Text="{Binding WarningText}"/>
            </DockPanel>
        </Border>

        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="4" Header="Local Library">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 6"
                                IsEnabled="{Binding LocalPane.IsReady}">
                        <Button x:Name="BTN_LocalCut" Content="Cut" Padding="10 2" Margin="0 0 4 0"
                                Click="OnCutButton" ToolTip="Cut the selected item(s) (Ctrl+X)"/>
                        <Button x:Name="BTN_LocalCopy" Content="Copy" Padding="10 2" Margin="0 0 4 0"
                                Click="OnCopyButton" ToolTip="Copy the selected item(s) (Ctrl+C)"/>
                        <Button x:Name="BTN_LocalPaste" Content="Paste" Padding="10 2" Margin="0 0 4 0"
                                Click="OnPasteButton" IsEnabled="{Binding LocalPane.HasClipboard}"
                                ToolTip="Paste onto the selected slot (Ctrl+V)"/>
                        <Button x:Name="BTN_LocalRename" Content="Rename..." Padding="10 2" Margin="0 0 4 0"
                                Click="OnRenameButton" ToolTip="Rename the selected item (F2)"/>
                        <Button x:Name="BTN_LocalDelete" Content="Delete" Padding="10 2" Margin="0 0 4 0"
                                Click="OnDeleteButton"
                                ToolTip="Deletes from the local library only - hardware is untouched until Commit. (Del)"/>
                        <Button x:Name="BTN_LocalClearChanges" Content="Clear Changes" Padding="10 2"
                                Click="OnClearChangesButton"
                                ToolTip="Revert every pending edit and deletion. Hardware is untouched."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="0 0 0 6" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding LocalPane.StatusText}"
                               ToolTip="{Binding LocalPane.StatusText, Converter={StaticResource EmptyToNull}}"/>

                    <TreeView Grid.Row="2" x:Name="TV_Local" ItemsSource="{Binding LocalPane.Roots}"
                              Visibility="{Binding LocalPane.ShowTree, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding LocalPane.IsReady}"
                              Style="{StaticResource LibraryTreeStyle}"
                              ItemTemplate="{StaticResource LocalNodeTemplate}"
                              ItemContainerStyle="{StaticResource LibraryTreeItemStyle}"
                              MouseDoubleClick="OnTreeDoubleClick"
                              PreviewKeyDown="OnLocalTreeKeyDown"
                              AllowDrop="True" DragOver="OnLocalDragOver" Drop="OnLocalDrop"/>

                    <TextBlock Grid.Row="2" Text="{Binding LocalPane.IndexingPlaceholder}"
                               Visibility="{Binding LocalPane.IsIndexing, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock Grid.Row="2" Text="{Binding LocalPane.EmptyLibraryHint}"
                               Visibility="{Binding LocalPane.ShowEmptyHint, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}"/>


                    <Border Grid.Row="3" Margin="0 6 0 0" Padding="0 5 0 0"
                            BorderThickness="0 1 0 0" BorderBrush="{StaticResource MutedTextBrush}"
                            ToolTip="Conflicted, pending-delete, and read-only rows are tinted, not dotted.">
                        <StackPanel Orientation="Vertical">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                                    <TextBlock Text="●" FontSize="9" VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerTextBrush}"/>
                                    <TextBlock Text="edited locally" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                                    <TextBlock Text="●" FontSize="9" VerticalAlignment="Center"
                                               Foreground="{StaticResource CommittedHighlightBrush}"/>
                                    <TextBlock Text="dependencies OK" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 2">
                                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerTextBrush}"/>
                                    <TextBlock Text="dependencies missing" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                                    <TextBlock Text="⚠" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource WarningTriangleBrush}"/>
                                    <TextBlock Text="conflicted" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                                    <Border Width="11" Height="11" VerticalAlignment="Center" Opacity="0.6"
                                            BorderThickness="1" BorderBrush="{StaticResource MutedTextBrush}"
                                            Background="{StaticResource PendingDeleteHighlightBrush}"/>
                                    <TextBlock Text="marked for deletion" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 2">
                                    <TextBlock Text="Aa" FontSize="10" FontFamily="Consolas" Opacity="0.6"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="read-only (GM/g)" FontSize="10" Margin="4 0 0 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Merge Window">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0 0 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Padding="10 2" MinWidth="128" HorizontalAlignment="Left"
                                Command="{Binding AutoFillToLibraryCommand}"
                                ToolTip="Place everything staged into the next free slots of its own type - Programs, then Combis, then Set Lists. Anything that doesn't fit stays staged.">
                            <Grid>
                                <ProgressBar IsIndeterminate="True" Height="14" Opacity="0.35"
                                             Background="Transparent" BorderThickness="0"
                                             Visibility="{Binding IsAutoFilling, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Auto-Fill to Library"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoFilling}" Value="True">
                                                    <Setter Property="Text" Value="Filling..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Force Overwrite" VerticalAlignment="Center" Margin="0 0 12 0"
                                      IsChecked="{Binding MergePane.ForceOverwrite}"
                                      ToolTip="Allow overwriting a slot another Combi or Set List still references."/>
                            <Button Content="Clear Merge" Padding="10 2"
                                    Click="OnClearMergeButton"
                                    ToolTip="Abandon everything staged here."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0 0 0 6" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding MergePane.StatusText}"
                               ToolTip="{Binding MergePane.StatusText, Converter={StaticResource EmptyToNull}}"/>

                    <TreeView Grid.Row="2" x:Name="TV_Merge" ItemsSource="{Binding MergePane.Roots}"
                              Style="{StaticResource LibraryTreeStyle}"
                              ItemTemplate="{StaticResource MergeNodeTemplate}"
                              ItemContainerStyle="{StaticResource LibraryTreeItemStyle}"
                              AllowDrop="True" DragOver="OnMergeDragOver" Drop="OnMergeDrop"/>

                    <!-- What's staged, and what it still needs - see MergePaneViewModel.RefreshTally.
                         The missing-dependency line turns red the moment anything staged references
                         something nothing staged provides, so a gap is visible without opening the
                         Object Dependencies panel. -->
                    <StackPanel Grid.Row="3" Margin="0 6 0 0"
                                ToolTip="What's staged in the Merge Window right now.">
                        <TextBlock Text="{Binding MergePane.TallyText}" FontSize="10"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock FontSize="10" Margin="0 2 0 0"
                                   Text="{Binding MergePane.MissingDependencyCount, StringFormat='Total missing dependencies: {0}'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MergePane.HasMissingDependencies}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource MissingDependencyTextBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="4" Margin="0 6 0 0" Padding="0 5 0 0"
                            BorderThickness="0 1 0 0" BorderBrush="{StaticResource MutedTextBrush}"
                            ToolTip="A dot marks an object staged or referenced more than once.">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Foreground="#FFD4C020"/>
                                <TextBlock Text="shared by multiple Combis/Songs" FontSize="10" Margin="4 0 0 0"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="0" Header="Loaded PCG File">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 6">
                        <TextBlock Text="Load PCG..." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                        <Button Content="From Computer" Margin="8 0 0 0" Padding="8 2"
                                Command="{Binding LoadPcgFromComputerCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="From Kronos" Margin="8 0 0 0" Padding="8 2"
                                Command="{Binding LoadPcgFromKronosCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="0 0 0 6" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding PcgPane.StatusText}"
                               ToolTip="{Binding PcgPane.StatusText, Converter={StaticResource EmptyToNull}}"/>

                    <TreeView Grid.Row="2" x:Name="TV_Pcg" ItemsSource="{Binding PcgPane.Roots}"
                              Style="{StaticResource LibraryTreeStyle}"
                              ItemTemplate="{StaticResource PcgNodeTemplate}"
                              ItemContainerStyle="{StaticResource PcgTreeItemStyle}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Height="180" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="History">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Clear History" Padding="10 2" Margin="0 0 0 6"
                            HorizontalAlignment="Left" Click="OnClearHistoryButton"
                            ToolTip="Permanently delete the local audit log. Nothing else is affected."/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding History}" FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush1}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0 2">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                        <TextBlock Text=" - synced" Foreground="{StaticResource CommittedHighlightBrush}" FontSize="10"
                                                   Visibility="{Binding IsSynced, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Object Dependencies"
                      ToolTip="Red rows are missing dependencies - right-click one to search a .pcg.">
              <Grid Margin="6">
                <ListBox x:Name="LST_ObjectDependencies" ItemsSource="{Binding ObjectDependencyRows}" FontFamily="Consolas" FontSize="11"
                         Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush1}"
                         MouseDoubleClick="OnObjectDependencyRowDoubleClick"
                         ContextMenuOpening="OnObjectDependencyMenuOpening">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Color-codes a SAMPLE dependency row by its bucket (SampleBucket is
                                 null for a normal object-reference/ROM row, which keeps this
                                 ListBox's own default Foreground) - see ObjectDependencyRow's own
                                 comment. -->
                            <TextBlock Text="{Binding Description}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- A missing staged dependency - listed first and in
                                                 red, so a gap is visible while there's still time
                                                 to fill it. Never collides with the sample-bucket
                                                 triggers below: a gap row has no SampleBucket. -->
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MissingDependencyTextBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SampleBucket}" Value="Exs">
                                                <Setter Property="Foreground" Value="{StaticResource SampleExsTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SampleBucket}" Value="UserOrThirdParty">
                                                <Setter Property="Foreground" Value="{StaticResource SampleUserBankTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SampleBucket}" Value="SamplingModeRam">
                                                <Setter Property="Foreground" Value="{StaticResource SampleRamTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SampleBucket}" Value="ExiExternal">
                                                <Setter Property="Foreground" Value="{StaticResource SampleExiExternalTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnObjectDependencyRowRightDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="More Info..." Click="OnObjectDependencyMoreInfo"/>
                            <MenuItem x:Name="MI_ScanForDependency" Header="Search a PCG for this object..."
                                      Click="OnObjectDependencyScanPcg"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
              </Grid>
            </GroupBox>
        </Grid>

        <!-- Shared sample-dependency legend - applies to every tree above (the blue dot) AND to
             the Object Dependencies panel's own text colors, so it lives once here rather than
             repeated per pane (it used to be, before the user asked for this consolidation). -->
        <Border Grid.Row="4" Margin="0 8 0 0" Padding="0 5 0 0"
                BorderThickness="0 1 0 0" BorderBrush="{StaticResource MutedTextBrush}"
                ToolTip="Applies to every tree above and to the Object Dependencies panel.">
            <WrapPanel Orientation="Horizontal">
                <!-- Not a sample color - listed first because it's the one entry here that means
                     "act on this", and the Object Dependencies panel is the only place it appears. -->
                <StackPanel Orientation="Horizontal" Margin="0 0 16 2">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource MissingDependencyTextBrush}"/>
                    <TextBlock Text="Missing dependency (right-click to search a PCG)" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 16 2">
                    <TextBlock Text="●" FontSize="9" VerticalAlignment="Center"
                               Foreground="{StaticResource SampleDependencyDotBrush}"/>
                    <TextBlock Text="Sample Dependency" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <TextBlock Text="Sample Dependency Type:" FontSize="10" Margin="0 0 6 2"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SampleExsTextBrush}"/>
                    <TextBlock Text="EXs" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SampleUserBankTextBrush}"/>
                    <TextBlock Text="User/3rd-Party bank" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 12 2">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SampleRamTextBrush}"/>
                    <TextBlock Text="live Sampling Mode (RAM)" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 2">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SampleExiExternalTextBrush}"/>
                    <TextBlock Text="EXi (MOD-7/STR-1) external bank" FontSize="10" Margin="4 0 0 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0 8 0 0">
            <TextBlock x:Name="TXT_Hint" FontSize="11" Foreground="#FF777777" VerticalAlignment="Center"
                       Text="Sync Library button (Pull Only, Push Only, or 2-Way) syncs up, down, or both. Drag from the PCG pane to copy in, or right-click it to move into the Merge Window; double-click for properties."/>
        </DockPanel>
    </Grid>
</local:ThemedWindow>
