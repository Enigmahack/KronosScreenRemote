<local:ThemedWindow x:Class="KronosScreenRemote.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Kronos ScreenRemote - Help"
        Width="780" Height="700"
        MinWidth="520" MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <FlowDocumentScrollViewer x:Name="HelpViewer"
                              Background="{StaticResource WindowBackgroundBrush}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"/>
</local:ThemedWindow>
