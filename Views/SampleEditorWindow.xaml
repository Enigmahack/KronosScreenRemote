<local:ThemedWindow x:Class="KronosScreenRemote.SampleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        xmlns:vm="clr-namespace:KronosScreenRemote.ViewModels"
        Title="Sample Editor - Kronos" Width="1100" Height="700" MinWidth="800" MinHeight="500"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Margin" Value="0 0 12 6"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:SampleTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ── Menu ──────────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}">
            <MenuItem Header="_File">
                <MenuItem x:Name="MNU_OpenCollection" Header="_Open Collection (.KSC)..." Click="OnOpenCollection"/>
                <MenuItem x:Name="MNU_OpenKmp" Header="Open _Multisample (.KMP)..." Click="OnOpenKmpDirect"/>
                <MenuItem x:Name="MNU_RecentFiles" Header="_Recent Files" SubmenuOpened="OnRecentFilesSubmenuOpened"/>
                <Separator/>
                <MenuItem x:Name="MNU_NewCollection" Header="_New Collection (.KSC)..." Click="OnNewCollection"/>
                <MenuItem x:Name="MNU_NewMultisample" Header="New M_ultisample in Collection..." Click="OnNewMultisample"/>
                <MenuItem x:Name="MNU_NewStereoPair" Header="New _Stereo Multisample Pair..." Click="OnNewStereoMultisamplePair"/>
                <Separator/>
                <MenuItem x:Name="MNU_SaveMultisample" Header="Save _Multisample" Click="OnSaveMultisample"/>
                <MenuItem x:Name="MNU_SaveSample" Header="Save _Sample" Click="OnSaveSample"/>
                <Separator/>
                <MenuItem x:Name="MNU_PullCollection" Header="Pull Collection from _Kronos (.KSC)..." Click="OnPullCollectionFromKronos"/>
                <MenuItem x:Name="MNU_PullMultisample" Header="Pull Multisample from Kronos (._KMP)..." Click="OnPullMultisampleFromKronos"/>
                <MenuItem x:Name="MNU_PushSample" Header="Push Sample to Kronos" Click="OnPushSampleToKronos"/>
                <MenuItem x:Name="MNU_PushMultisample" Header="Push Multisample to Kronos" Click="OnPushMultisampleToKronos"/>
                <Separator/>
                <MenuItem x:Name="MNU_ImportAudio" Header="_Import Audio (WAV/MP3/MP4)..." Click="OnImportAudio"/>
                <MenuItem x:Name="MNU_ImportStereoAudio" Header="Import Audio as Stereo _Pair..." Click="OnImportStereoAudio"/>
                <MenuItem x:Name="MNU_ExportSample" Header="Export Sample to WAV..." Click="OnExportSample"/>
                <MenuItem x:Name="MNU_ExportMultisample" Header="Export Multisample to Folder..." Click="OnExportMultisample"/>
                <MenuItem x:Name="MNU_ExportCollection" Header="Export Collection to Folder..." Click="OnExportCollection"/>
                <Separator/>
                <MenuItem x:Name="MNU_NormalizationReport" Header="_Normalization Report..." Click="OnNormalizationReport"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="MNU_Undo" Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo"/>
                <MenuItem x:Name="MNU_Redo" Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo"/>
                <Separator/>
                <MenuItem x:Name="MNU_DeleteZone" Header="_Delete Zone" InputGestureText="Del" Click="OnDeleteZone"/>
            </MenuItem>
        </Menu>

        <!-- ── Status bar ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="#FF444444" BorderThickness="0 1 0 0" Padding="6 3">
            <TextBlock x:Name="StatusBar" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Collection / Multisample / Zone tree ───────────────── -->
            <TreeView x:Name="SampleTree" Grid.Column="0"
                      Background="{StaticResource PanelBackgroundBrush}"
                      BorderThickness="0"
                      SelectedItemChanged="OnTreeSelectionChanged"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#FF444444"/>

            <!-- ── Right: zone + sample detail, waveform ─────────────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="Zone" FontWeight="SemiBold" FontSize="14" Margin="0 0 0 8"/>
                    <StackPanel x:Name="ZonePanel" Orientation="Horizontal" Margin="0 0 0 16">
                        <TextBlock Text="Filename:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="ZoneFilenameText" VerticalAlignment="Center" Margin="0 0 20 0"/>
                        <TextBlock Text="Original Key:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ZoneOrigKeyBox" Style="{StaticResource FieldBox}" Width="50"/>
                        <TextBlock Text="Top Key:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ZoneTopKeyBox" Style="{StaticResource FieldBox}" Width="50"/>
                        <Button x:Name="BtnApplyZone" Content="Apply" Click="OnApplyZone" Height="24" Padding="10 0" Margin="0 0 6 0"/>
                        <Button x:Name="BtnDeleteZone" Content="Delete Zone" Click="OnDeleteZone" Height="24" Padding="10 0"/>
                    </StackPanel>

                    <TextBlock Text="Sample" FontWeight="SemiBold" FontSize="14" Margin="0 0 0 8"/>
                    <StackPanel x:Name="SamplePanel">
                        <WrapPanel Margin="0 0 0 4">
                            <TextBlock Text="Name:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="SampleNameText" VerticalAlignment="Center" Margin="0 0 20 6"/>
                            <TextBlock Text="Frames:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="SampleFramesText" VerticalAlignment="Center" Margin="0 0 20 6"/>
                            <TextBlock x:Name="SampleWarningText" Foreground="{StaticResource DangerTextBrush}"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>
                        <WrapPanel>
                            <!-- Each label+textbox is grouped into its own StackPanel so WrapPanel
                                 wraps them as an atomic pair, never splitting a label from its box
                                 onto separate lines (found via an actual screenshot - see
                                 Tools/SampleEditorVisualCheck.cs). -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sample Rate:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SampleRateBox" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <CheckBox x:Name="LoopEnabledBox" Content="Loop Enabled" VerticalAlignment="Center" Margin="0 0 12 6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sample Start:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SampleStartBox" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Loop Start:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoopStartBox" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Loop End:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoopEndBox" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <Button x:Name="BtnApplySample" Content="Apply" Click="OnApplySample" Height="24" Padding="10 0" Margin="0 0 0 6"/>
                        </WrapPanel>

                        <local:SampleWaveformControl x:Name="Waveform" Height="200" Margin="0 12 0 4"
                                                      SelectionChanged="OnWaveformSelectionChanged"/>
                        <TextBlock x:Name="SelectionInfoText" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0 0 0 8" FontSize="11"/>

                        <TextBlock Text="Edit" FontWeight="SemiBold" FontSize="14" Margin="0 4 0 8"/>
                        <WrapPanel Margin="0 0 0 4">
                            <Button x:Name="BtnPlay" Content="▶ Play" Click="OnPlay" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                            <Button x:Name="BtnStop" Content="■ Stop" Click="OnStop" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                            <CheckBox x:Name="LoopPreviewBox" Content="Loop Preview" VerticalAlignment="Center" Margin="0 0 16 6"
                                      ToolTip="Play repeats between Loop Start/Loop End instead of playing once"/>
                            <Button x:Name="BtnUndo" Content="↶ Undo" Click="OnUndo" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                            <Button x:Name="BtnRedo" Content="↷ Redo" Click="OnRedo" Height="26" Padding="10 0" Margin="0 0 16 6"/>
                            <Button x:Name="BtnCrop" Content="Crop to Selection" Click="OnCrop" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                            <Button x:Name="BtnNormalize" Content="Normalize" Click="OnNormalize" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                            <Button x:Name="BtnTrimSilence" Content="Trim Silence" Click="OnTrimSilence" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                        </WrapPanel>
                        <WrapPanel Margin="0 0 0 4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fade In (frames):" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FadeInBox" Style="{StaticResource FieldBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fade Out (frames):" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FadeOutBox" Style="{StaticResource FieldBox}" Text="0"/>
                            </StackPanel>
                            <Button x:Name="BtnFade" Content="Apply Fade" Click="OnFade" Height="26" Padding="10 0" Margin="0 0 16 6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tempo x:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TempoBox" Style="{StaticResource FieldBox}" Text="1.0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pitch (semitones):" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PitchBox" Style="{StaticResource FieldBox}" Text="0"/>
                            </StackPanel>
                            <Button x:Name="BtnTempoPitch" Content="Apply Tempo/Pitch" Click="OnTempoPitch" Height="26" Padding="10 0" Margin="0 0 4 6"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock x:Name="NoSelectionText" Text="Select a zone in the tree to view/edit its sample."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0 8 0 0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
