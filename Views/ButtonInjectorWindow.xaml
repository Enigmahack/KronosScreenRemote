<local:ThemedWindow x:Class="KronosScreenRemote.ButtonInjectorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Button Injector"
        Width="720" Height="640"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource WindowBackgroundBrush}" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Layout: " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="CboLayout" Width="110" SelectedIndex="0"
                          SelectionChanged="CboLayout_SelectionChanged">
                    <ComboBoxItem Content="Kronos"/>
                    <ComboBoxItem Content="Nautilus"/>
                </ComboBox>
                <TextBlock Text="Sends BUTTON &lt;name&gt; on the daemon ctrl port and shows what happens on the mirrored screen. Edit a label and tab/click away to save it for the selected layout."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource WindowBackgroundBrush}" Padding="10,6">
            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        </Border>

        <DataGrid x:Name="EntryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource InputBackgroundBrush}"
                  VerticalGridLinesBrush="Transparent"
                  Background="#FF1E1E1E"
                  RowBackground="#FF1E1E1E"
                  AlternatingRowBackground="#FF212121"
                  RowHeight="26"
                  FontFamily="Consolas" FontSize="13"
                  Foreground="#FFCCCCCC"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code"     Binding="{Binding Code}"        Width="45"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Token"    Binding="{Binding Token}"       Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}"    Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description (Kronos)" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Label (this layout)" Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" Width="160" IsReadOnly="False"/>
                <DataGridTemplateColumn Header="" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Send" Padding="8,2" Margin="2,1"
                                    Tag="{Binding}" Click="BtnSendRow_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</local:ThemedWindow>
