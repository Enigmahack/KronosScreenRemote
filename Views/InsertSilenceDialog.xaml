<local:ThemedWindow x:Class="KronosScreenRemote.InsertSilenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Insert Silence" Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLabel" Text="Frames of silence to insert:" TextWrapping="Wrap"/>

        <!-- Frames is the value actually applied - Core/Sample/Dsp's InsertSilenceEffect
             takes a frame count, same as every other position field in this window
             (Sample Start/Loop Start/Loop End). Seconds is a second, LINKED entry point
             onto that same value, not an independent unit the effect understands. -->
        <TextBlock Grid.Row="2" Text="Frames"/>
        <TextBox   Grid.Row="4" x:Name="FramesBox" TextChanged="OnFramesChanged"/>

        <TextBlock Grid.Row="6" Text="Seconds"/>
        <TextBox   Grid.Row="8" x:Name="SecondsBox" TextChanged="OnSecondsChanged"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Click="OnCancel"
                    Margin="0 0 8 0" Style="{StaticResource DialogButtonStyle}"/>
            <Button x:Name="BtnOk"    Content="OK"     IsDefault="True" Click="OnOk" Style="{StaticResource DialogButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:ThemedWindow>
