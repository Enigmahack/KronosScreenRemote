<Window x:Class="KronosScreenRemote.LibrarianWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Librarian — coherent move (Programs / Combis)"
        Width="940" Height="760"
        MinWidth="640" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Safety banner -->
        <Border Grid.Row="0" Background="#FF3A1414" BorderBrush="#FF7A2A2A" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0 0 0 8">
            <TextBlock Foreground="#FFFFD0D0" FontSize="12" TextWrapping="Wrap"
                       Text="LIVE WRITES to the instrument. A move rewrites Combi/Set List references and commits whole banks (Store Bank 0x76). Before enabling Commit, verify the Store-Bank spike on THIS unit (dump a USER bank, write one object, Store, re-dump, confirm untouched slots survived). Keep 'Enable Exclusive' ON in Global &gt; MIDI."/>
        </Border>

        <!-- Scan row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8">
            <Button x:Name="BTN_Scan" Content="Scan Library" Width="110"
                    ToolTip="Dump in-use Combis and Set Lists to build the reference index (usage counts + coherency)."/>
            <CheckBox x:Name="CHK_Full" Content="Full scan (all banks/slots)" VerticalAlignment="Center" Margin="12 0 0 0"
                      ToolTip="Sweep every combi slot and all 128 set lists, not just named ones. Slow but complete."/>
            <Button x:Name="BTN_ScanCancel" Content="Cancel" Width="70" Margin="12 0 0 0" IsEnabled="False"/>
            <TextBlock x:Name="TXT_ScanStatus" VerticalAlignment="Center" Margin="12 0 0 0"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Text="Not scanned"/>
        </StackPanel>

        <!-- Move controls -->
        <GroupBox Grid.Row="2" Header="Move (swap)" Margin="0 0 0 8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0 2 0 6">
                    <TextBlock Text="Object type:" VerticalAlignment="Center" Margin="0 0 8 0" Foreground="{StaticResource MutedTextBrush}"/>
                    <RadioButton x:Name="RB_Prog" Content="Program" IsChecked="True" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RB_Combi" Content="Combi" VerticalAlignment="Center" Margin="12 0 0 0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 2 0 4">
                    <TextBlock Text="Source:" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="Bank" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox x:Name="CMB_SrcBank" Width="90"/>
                    <TextBlock Text="No." VerticalAlignment="Center" Margin="10 0 4 0" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="TXT_SrcNum" Width="48" Text="0"/>
                    <TextBlock x:Name="TXT_SrcUsage" VerticalAlignment="Center" Margin="14 0 0 0" Foreground="#FF9ACD9A"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 2 0 4">
                    <TextBlock Text="Destination:" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="Bank" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox x:Name="CMB_DstBank" Width="90"/>
                    <TextBlock Text="No." VerticalAlignment="Center" Margin="10 0 4 0" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="TXT_DstNum" Width="48" Text="0"/>
                    <TextBlock x:Name="TXT_DstUsage" VerticalAlignment="Center" Margin="14 0 0 0" Foreground="#FF9ACD9A"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 6 0 2">
                    <Button x:Name="BTN_Preview" Content="Preview Move" Width="110"/>
                    <CheckBox x:Name="CHK_Live" Content="Live edit-buffer preview (0x43) if active" IsChecked="True"
                              VerticalAlignment="Center" Margin="12 0 0 0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Preview / log -->
        <TextBox Grid.Row="3" x:Name="TXT_Log" Style="{StaticResource ConsoleTextBoxStyle}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontSize="12"/>

        <!-- Commit row + spike gate -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 8 0 0">
            <CheckBox x:Name="CHK_Spike" Content="Store-Bank spike verified on this unit" VerticalAlignment="Center"
                      ToolTip="Required. Confirms 0x76 preserves untouched slots on this instrument (see the banner)."/>
            <Button x:Name="BTN_Commit" Content="Commit Move" Width="120" Margin="20 0 0 0"
                    Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="TXT_BackupHint" Margin="0 6 0 0" FontSize="11" Foreground="#FF777777"/>
    </Grid>
</Window>
