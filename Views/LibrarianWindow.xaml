<Window x:Class="KronosScreenRemote.LibrarianWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Librarian"
        Width="940" Height="760"
        MinWidth="640" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Safety banner -->
        <Border Grid.Row="0" Background="#FF3A1414" BorderBrush="#FF7A2A2A" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0 0 0 8">
            <TextBlock Foreground="#FFFFD0D0" FontSize="12" TextWrapping="Wrap"
                       Text="LIVE WRITES to the instrument. A move rewrites Combi/Set List references and commits whole banks. Keep 'Enable Exclusive' ON in Global &gt; MIDI."/>
        </Border>

        <!-- Scan row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8">
            <Button x:Name="BTN_Scan" Content="Scan Library" Width="110"
                    ToolTip="Lazy scan: re-fetch only combi banks and set lists that changed (or were never scanned) since last time, to build/update the reference index (usage counts + coherency)."/>
            <CheckBox x:Name="CHK_Full" Content="Full scan (re-fetch everything)" VerticalAlignment="Center" Margin="12 0 0 0"
                      ToolTip="Force a complete re-fetch of every combi bank and all 128 set lists, ignoring what's changed since the last scan. Slower but exhaustive."/>
            <Button x:Name="BTN_ScanCancel" Content="Cancel" Width="70" Margin="12 0 0 0" IsEnabled="False"/>
            <TextBlock x:Name="TXT_ScanStatus" VerticalAlignment="Center" Margin="12 0 0 0"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Text="Not scanned"/>
        </StackPanel>

        <!-- Sync row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 8">
            <Button x:Name="BTN_SyncNames" Content="Sync Names…" Width="110"
                    ToolTip="Request all program &amp; combi names from the Kronos and cache them locally."/>
            <Button x:Name="BTN_SyncAll" Content="Sync All…" Width="110" Margin="8 0 0 0"
                    ToolTip="Sync program/combi names and every set list (names, slot colors, notes), caching everything locally. Click again while running to cancel."/>
            <TextBlock x:Name="TXT_SyncStatus" VerticalAlignment="Center" Margin="12 0 0 0"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Move controls -->
        <GroupBox Grid.Row="3" Header="Move (swap)" Margin="0 0 0 8">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Unified Programs / Combis / Set Lists browser. Right-click a Program or
                     Combi slot to set it as Source or Destination for a move. Set List rows
                     are browsable here but not yet actionable (that lands with the embedded
                     Set List editor). -->
                <TreeView Grid.Row="0" x:Name="TV_Objects" MinHeight="160">
                    <!-- Neutralizes the native TreeViewItem.IsSelected highlight for THIS tree only
                         (resource lookup shadows the app-level Dark.xaml brushes for anything nested
                         inside TV_Objects.Resources, leaving every other control's native selection —
                         e.g. TV_Clipboard's — untouched). Selection here is entirely custom
                         (IsBatchSelected, below), because WPF TreeView's own IsSelected is
                         single-item-only and can't represent a multi-select. -->
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE0E0E0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <HierarchicalDataTemplate DataType="{x:Type local:ObjectBrowserNode}" ItemsSource="{Binding Children}">
                            <!-- The highlight lives on THIS Border, not TreeViewItem.Background: the
                                 stock TreeViewItem ControlTemplate has its own internal IsSelected
                                 trigger that paints its header border directly and wins over any
                                 TemplateBinding-sourced Background for whichever node WPF considers
                                 natively selected (always the last plain-clicked one, since plain
                                 clicks deliberately leave e.Handled unset so double-click-rename still
                                 works) — a Style-level trigger on TreeViewItem.Background is a no-op
                                 for that one node. A Border inside the template's OWN content is a
                                 different element the stock template has no power over, so it's driven
                                 by IsBatchSelected alone, with zero dependency on native IsSelected —
                                 single- and multi-select render identically, and nothing goes stale
                                 when _batchSelection is cleared (e.g. after a Copy) but native
                                 selection lingers. This Border is text-width, not full row width —
                                 same as the native highlight it replaces (the stock template's header
                                 content sits in an Auto-width column either way); a full-bleed row
                                 would need retemplating TreeViewItem itself, not asked for here. -->
                            <Border Padding="2 0" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelectionHighlightBrush}"/>
                                            </DataTrigger>
                                            <!-- Ordered after IsBatchSelected deliberately — a later-declared
                                                 matching trigger wins ties, so staging color (more important
                                                 information) visually overrides plain multi-select blue when
                                                 both apply (e.g. Ctrl-selecting an already-staged slot to Copy
                                                 something else). -->
                                            <DataTrigger Binding="{Binding PasteState}" Value="Staged">
                                                <Setter Property="Background" Value="{StaticResource StagedHighlightBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PasteState}" Value="Committed">
                                                <Setter Property="Background" Value="{StaticResource CommittedHighlightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"
                                           PreviewMouseLeftButtonDown="OnLeafPreviewMouseDown">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Copy to Clipboard" Click="OnCopyToClipboard"
                                                      ToolTip="Copies whatever is currently selected (Ctrl/Shift-click above) into the Clipboard below, ready to paste onto a destination slot."/>
                                            <MenuItem Header="Copy Bank to Clipboard" Click="OnCopyBank"
                                                      ToolTip="Right-click a BANK (or the Set Lists root), not a slot — copies every object in it as one group, ready for Paste Bank."/>
                                            <Separator/>
                                            <MenuItem Header="Paste Single" Click="OnPasteSingle"
                                                      ToolTip="Pastes one pending clipboard entry here — whichever is selected in the Clipboard list below, or the only pending match if there's just one."/>
                                            <MenuItem Header="Paste Multi" Click="OnPasteMulti"
                                                      ToolTip="Pastes whichever entries are Ctrl/Shift-selected in the Clipboard list below, sequentially, starting exactly here."/>
                                            <MenuItem Header="Paste All" Click="OnPasteAll"
                                                      ToolTip="Pastes every pending, matching-type clipboard entry, sequentially, starting exactly here."/>
                                            <MenuItem Header="Paste Bank" Click="OnPasteBank"
                                                      ToolTip="Right-click a BANK (or the Set Lists root), not a slot — restores a whole previously bank-copied group, slot-for-slot, starting at slot 0."/>
                                            <Separator/>
                                            <MenuItem Header="Unstage" Click="OnUnstage"
                                                      ToolTip="Undo a staged (red) paste or swap slot here before Commit."/>
                                            <Separator/>
                                            <MenuItem Header="Set as Source" Click="OnSetAsSource"/>
                                            <MenuItem Header="Set as Destination" Click="OnSetAsDestination"/>
                                            <Separator/>
                                            <MenuItem Header="Rescan" Click="OnRescan"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 6 0 2">
                    <TextBlock Text="Source:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="TXT_SrcUsage" VerticalAlignment="Center" Foreground="#FF9ACD9A" Text="(right-click a Program/Combi slot above)"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 2 0 4">
                    <TextBlock Text="Destination:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="TXT_DstUsage" VerticalAlignment="Center" Foreground="#FF9ACD9A" Text="(right-click a Program/Combi slot above)"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 6 0 2">
                    <CheckBox x:Name="CHK_Live" Content="Live edit-buffer preview (0x43) if active" IsChecked="True"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Clipboard — Copy / Paste: the primary way to relocate Programs/Combis/Set Lists.
             Right-click Copy to Clipboard (or Copy Bank to Clipboard, on a bank node) on whatever's
             selected above, then right-click a destination and choose a paste variant (Single/
             Multi/All/Bank) — see the shared ContextMenu on the tree above. Pasting stages
             immediately (destination turns red) and needs no destination-bank picker; Verify/
             Commit at the bottom of the window act on whatever's staged, clipboard or swap alike.
             Always visible — a permanent fixture, not a collapsible extra. Side-by-side with the
             swap GroupBox above, not a replacement — that flow stays untouched. -->
        <GroupBox Grid.Row="4" x:Name="GRP_Clipboard" Header="Clipboard — Copy / Paste" Margin="0 0 0 8">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Selection:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="TXT_BatchSelection" VerticalAlignment="Center" Foreground="#FF9ACD9A"
                                   Text="(Ctrl/Shift-click Program, Combi, or Set List slots above)"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BTN_ClearClipboard" Content="Clear Clipboard" Padding="8 2"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Remove every entry from the clipboard (pending and pasted-history alike). Cannot be undone."/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 6">
                    <CheckBox x:Name="CHK_BatchDivertToClipboard" Content="Divert displaced objects to clipboard"
                              VerticalAlignment="Center"
                              ToolTip="When a paste overwrites a slot that already holds something, check this to save that object's current contents into the Clipboard below instead of losing it — it stays there, untouched, until you explicitly paste it into another slot you choose."/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Clipboard — right-click a Program/Combi/Set List slot (or a bank) above and choose a Copy action, then right-click a destination and choose a Paste variant. Combi/Set List entries expand (click the arrow) to show what they reference. Pasted entries stay listed (marked Pasted) as a running history."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 4"/>
                <TreeView Grid.Row="3" x:Name="TV_Clipboard" MaxHeight="160">
                    <!-- Same native-selection neutralization + content-level Border technique as
                         TV_Objects above (see its comment) — needed here now that clipboard rows
                         support Ctrl/Shift multi-select too (Paste Multi). -->
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE0E0E0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <HierarchicalDataTemplate DataType="{x:Type local:ClipboardRow}" ItemsSource="{Binding Children}">
                            <Border Padding="2 0" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelectionHighlightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"
                                           PreviewMouseLeftButtonDown="OnClipboardRowPreviewMouseDown"/>
                            </Border>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:ClipboardRefRow}">
                            <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="2 0"/>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </GroupBox>

        <!-- Prominent plan-warning banner (e.g. cross-bank-type CHECK) — hidden unless
             the current preview raised a non-refusable warning worth a second look. -->
        <Border Grid.Row="5" x:Name="BRD_Warning" Background="#FF4A3410" BorderBrush="#FFC08A20"
                BorderThickness="2" CornerRadius="4" Padding="10" Margin="0 0 0 8" Visibility="Collapsed">
            <TextBlock x:Name="TXT_Warning" Foreground="#FFFFE0A0" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>

        <!-- Preview / log -->
        <TextBox Grid.Row="6" x:Name="TXT_Log" Style="{StaticResource ConsoleTextBoxStyle}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap" FontSize="12"/>

        <!-- Verify / Commit — shared by both the swap flow (Set as Source/Destination) and the
             clipboard/paste flow (right-click Copy + Paste above): both produce an
             IExecutablePlan through the same ArmPlanAsync/ApplyMoveAsync machinery, so one
             Verify re-dumps fresh and confirms/REFUSEs whatever's currently staged, and one
             Commit writes it. -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0 8 0 0">
            <Button x:Name="BTN_Verify" Content="Verify" Width="110"/>
            <Button x:Name="BTN_CommitAll" Content="Commit Move" Width="120" Margin="12 0 0 0"
                    Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="TXT_BackupHint" Margin="0 6 0 0" FontSize="11" Foreground="#FF777777"/>
    </Grid>
</Window>
