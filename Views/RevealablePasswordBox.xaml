<UserControl x:Class="KronosScreenRemote.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KronosScreenRemote">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="PART_Password" PasswordChanged="Password_PasswordChanged"/>
            <TextBox     x:Name="PART_Reveal" Visibility="Collapsed" TextChanged="Reveal_TextChanged"/>
        </Grid>

        <!-- Transparent icon-only button, same pattern as the small "x" delete buttons
             elsewhere in this app (e.g. InputTesterWindow's mapping-row delete). -->
        <Button x:Name="PART_Eye" Grid.Column="1" Click="Eye_Click"
                Margin="4,0,0,0" Padding="4,0"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                ToolTip="Show password">
            <TextBlock x:Name="EyeGlyph" Text="👁" FontSize="13" Foreground="#FF999999"/>
        </Button>
    </Grid>
</UserControl>
