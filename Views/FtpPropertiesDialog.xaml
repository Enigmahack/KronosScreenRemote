<local:ThemedWindow x:Class="KronosScreenRemote.FtpPropertiesDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="Properties"
        SizeToContent="Height" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 8" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" TextWrapping="Wrap" Margin="0 0 0 8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 8" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PathText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 8"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TypeText" Margin="0 0 0 8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 8"/>
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModifiedText" Margin="0 0 0 8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Permissions:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 8" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PermissionsText" TextWrapping="Wrap" Margin="0 0 0 8"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Size:" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 10 0" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="SizeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="BtnCalculate" Content="Calculate" Click="OnCalculate" Margin="10 0 0 0" Padding="8 2"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" Style="{StaticResource DialogButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:ThemedWindow>
