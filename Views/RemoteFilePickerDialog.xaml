<Window x:Class="KronosScreenRemote.RemoteFilePickerDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select File on Kronos"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 8">
            <Button x:Name="BTN_Up" Content="↑ Up" Click="OnUp" Width="60"/>
            <TextBlock x:Name="TXT_Path" VerticalAlignment="Center" Margin="10 0 0 0" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="LST_Items" MouseDoubleClick="OnItemDoubleClick" FontFamily="Consolas">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" x:Name="TXT_Status" Margin="0 6 0 0" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
            <Button x:Name="BTN_Cancel" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0 0 8 0" MinWidth="75"/>
            <Button x:Name="BTN_Select" Content="Select" Click="OnSelect" MinWidth="75" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
