<Window x:Class="KronosScreenRemote.SetListSlotEditDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TXT_Header" FontWeight="Bold" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Name" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        <TextBox   Grid.Row="4" x:Name="TXT_Name" MaxLength="24"/>

        <TextBlock Grid.Row="6" Text="Notes" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        <TextBox   Grid.Row="8" x:Name="TXT_Notes" MaxLength="512" Height="90"
                   TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Click="OnCancel"
                    Margin="0 0 8 0" MinWidth="75"/>
            <Button x:Name="BtnSave"  Content="Save"   IsDefault="True" Click="OnSave" MinWidth="75"/>
        </StackPanel>
    </Grid>
</Window>
