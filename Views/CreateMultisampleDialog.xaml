<local:ThemedWindow x:Class="KronosScreenRemote.CreateMultisampleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLabel" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="2" x:Name="StereoBox" Content="Stereo"
                  ToolTip="Checked: creates a matched -L/-R multisample pair (two adjacent slots). Unchecked: creates a single mono multisample (one slot)."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Click="OnCancel"
                    Margin="0 0 8 0" Style="{StaticResource DialogButtonStyle}"/>
            <Button x:Name="BtnOk"    Content="OK"     IsDefault="True" Click="OnOk" Style="{StaticResource DialogButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:ThemedWindow>
