<local:ThemedWindow x:Class="KronosScreenRemote.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KronosScreenRemote"
        Title="About Kronos ScreenRemote"
        Width="400" Height="510"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="28 24 28 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Kronos ScreenRemote"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#FFDDEEFF"/>

        <TextBlock Grid.Row="1"
                   Text="Remote viewer and control for Korg Kronos"
                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                   Margin="0 4 0 0"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Client version"   Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TXT_ClientVer"  Foreground="#FFD0D0D0" FontSize="12" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Client build ID"  Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 4 0 0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TXT_ClientBuild" Foreground="#FFD0D0D0" FontSize="12" FontFamily="Consolas" Margin="0 4 0 0"/>

            <!-- Client repo - directly below the Client version/build ID rows. -->
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LNK_ClientRepo"
                       Text="https://github.com/Enigmahack/KronosScreenRemote"
                       Foreground="{StaticResource AccentBrush}" FontSize="11"
                       Cursor="Hand" TextDecorations="Underline" TextWrapping="Wrap" Margin="0 6 0 0"
                       MouseLeftButtonDown="OnLinkClick" Tag="https://github.com/Enigmahack/KronosScreenRemote"
                       ToolTip="https://github.com/Enigmahack/KronosScreenRemote"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Daemon version"   Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TXT_DaemonVer"  Foreground="#FFD0D0D0" FontSize="12" FontFamily="Consolas"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Daemon build ID"  Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 4 0 0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TXT_DaemonBuild" Foreground="#FFD0D0D0" FontSize="12" FontFamily="Consolas" Margin="0 4 0 0"/>

            <!-- Daemon repo - directly below the Daemon version/build ID rows. -->
            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LNK_DaemonRepo"
                       Text="https://github.com/Enigmahack/KronosScreenRemoteDaemon"
                       Foreground="{StaticResource AccentBrush}" FontSize="11"
                       Cursor="Hand" TextDecorations="Underline" TextWrapping="Wrap" Margin="0 6 0 0"
                       MouseLeftButtonDown="OnLinkClick" Tag="https://github.com/Enigmahack/KronosScreenRemoteDaemon"
                       ToolTip="https://github.com/Enigmahack/KronosScreenRemoteDaemon"/>

            <!-- Email - directly below the Daemon GitHub link. -->
            <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LNK_Email"
                       Text="dave.champagne1@gmail.com"
                       Foreground="{StaticResource AccentBrush}" FontSize="11"
                       Cursor="Hand" TextDecorations="Underline" TextWrapping="Wrap" Margin="0 6 0 0"
                       MouseLeftButtonDown="OnLinkClick" Tag="mailto:dave.champagne1@gmail.com"
                       ToolTip="mailto:dave.champagne1@gmail.com"/>
        </Grid>

        <!-- Sponsor credit. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,9" Width="324">
            <TextBlock Text="Sponsored by: " VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            <Image Source="/Resources/Images/AA_logo.PNG" Height="128" VerticalAlignment="Center"
                   Cursor="Hand" MouseLeftButtonDown="OnLinkClick" Tag="https://www.audora.ca"
                   ToolTip="https://www.audora.ca" Width="157"/>
        </StackPanel>

        <!-- Donate button. -->
        <Button Grid.Row="7" x:Name="BTN_Donate"
                Content="Donate Here!"
                HorizontalAlignment="Left"
                Width="140" Height="28" Margin="10,4,0,10"
                Click="OnDonateClick" Tag="https://www.paypal.com/paypalme/audora/"
                ToolTip="https://www.paypal.com/paypalme/audora/"/>

        <!-- Close - the very bottom right of the window, after everything else. -->
        <Button Grid.Row="7"
                Content="Close"
                HorizontalAlignment="Right"
                Width="80" Height="28" Margin="0,4,10,10"
                Click="CloseButton_Click"/>
    </Grid>
</local:ThemedWindow>
