<Window x:Class="KronosScreenRemote.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLabel" TextWrapping="Wrap"/>
        <TextBox   Grid.Row="2" x:Name="InputBox"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Click="OnCancel"
                    Margin="0 0 8 0" MinWidth="75"/>
            <Button x:Name="BtnOk"    Content="OK"     IsDefault="True" Click="OnOk" MinWidth="75"/>
        </StackPanel>
    </Grid>
</Window>
