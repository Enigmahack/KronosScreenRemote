<Window x:Class="KronosScreenRemote.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kronos FTP Login" Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Subtitle -->
        <TextBlock Grid.Row="0" x:Name="SubtitleText" Foreground="#FFAAAAAA" FontSize="11"/>

        <!-- Username -->
        <TextBlock Grid.Row="2" Text="Username"/>
        <TextBox   Grid.Row="4" x:Name="TxtUser"/>

        <!-- Password -->
        <TextBlock Grid.Row="6" Text="Password"/>
        <PasswordBox Grid.Row="8" x:Name="PwdBox"/>

        <!-- Save password -->
        <CheckBox Grid.Row="10" x:Name="ChkSave" Content="Save password" IsChecked="True"/>

        <!-- Error -->
        <TextBlock Grid.Row="12" x:Name="ErrorText"
                   Foreground="#FFFF7777" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Buttons -->
        <DockPanel Grid.Row="14">
            <Button x:Name="BtnClear" Content="Clear" Click="OnClear" DockPanel.Dock="Left" MinWidth="75"
                    ToolTip="Clear both fields so you can enter fresh credentials"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0 0 8 0" MinWidth="75"/>
                <Button x:Name="BtnOk"    Content="OK"     IsDefault="True" Click="OnOk" MinWidth="75"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
